showStateTransitions = input.bool(true, "Show State Transition Labels / 顯示狀態轉換標籤", group="01 Display / 顯示")

atrLength = input.int(14, "ATR Length For Normalisation / ATR 標準化長度", minval=1, group="02 Core Thresholds / 核心門檻")
structureLookback = input.int(20, "Structure Lookback / 結構回望", minval=5, group="02 Core Thresholds / 核心門檻")
swingLeft = input.int(3, "Swing Left Bars / 左側確認支數", minval=1, group="02 Core Thresholds / 核心門檻")
swingRight = input.int(3, "Swing Right Bars / 右側確認支數", minval=1, group="02 Core Thresholds / 核心門檻")
levelToleranceAtr = input.float(0.25, "Level Tolerance ATR / 水平容許距離 ATR", minval=0.0, step=0.05, group="02 Core Thresholds / 核心門檻")
breakoutBufferAtr = input.float(0.05, "Breakout Buffer ATR / 突破緩衝 ATR", minval=0.0, step=0.01, group="02 Core Thresholds / 核心門檻")
