retestToleranceAtr = input.float(0.25, "Retest Tolerance ATR / 回測容許 ATR", minval=0.0, step=0.05, group="02 Core Thresholds / 核心門檻")
followThroughBars = input.int(3, "Follow-Through Bars / 突破確認等待支數", minval=1, maxval=20, group="02 Core Thresholds / 核心門檻")
maxFailureBars = input.int(5, "Maximum Failure Bars / 最大假突破支數", minval=1, maxval=50, group="02 Core Thresholds / 核心門檻")
stateExpiryBars = input.int(40, "Breakout State Expiry Bars / 突破狀態過期支數", minval=5, maxval=500, group="02 Core Thresholds / 核心門檻")
breakDistanceQualityFullAtr = input.float(0.20, "Break Distance Full Quality ATR / 突破距離滿分 ATR", minval=0.01, step=0.01, group="02 Core Thresholds / 核心門檻")
closeMomentumLookback = input.int(5, "Close Momentum Decline Lookback / 收市動能下降回望", minval=2, maxval=50, group="02 Core Thresholds / 核心門檻")
closeMomentumComparisonOffset = input.int(5, "Close Momentum Prior Offset / 收市動能早段比較偏移", minval=1, maxval=100, group="02 Core Thresholds / 核心門檻")

consolidationLookback = input.int(18, "Consolidation Lookback / 整固回望", minval=5, group="03 Consolidation / 整固")
maxConsolidationEfficiency = input.float(0.35, "Max Consolidation Efficiency / 最高整固效率", minval=0, maxval=1, step=0.05, group="03 Consolidation / 整固")
minOverlapThreshold = input.float(0.45, "Min Average Overlap / 最低平均重疊", minval=0, maxval=1, step=0.05, group="03 Consolidation / 整固")
maxWindowRangeAtr = input.float(2.2, "Max Window Range ATR / 最大窗口範圍 ATR", minval=0.1, step=0.1, group="03 Consolidation / 整固")
minDirectionChangeRatio = input.float(0.35, "Min Direction Change Ratio / 最低方向轉換比例", minval=0, maxval=1, step=0.05, group="03 Consolidation / 整固")

minBodyRatio = input.float(0.45, "Minimum Body Ratio / 最低實體比例", minval=0, maxval=1, step=0.05, group="04 Candle Behaviour / 蠟燭行為")
minLowerWickRatio = input.float(0.35, "Minimum Lower Wick Ratio / 最低下影線比例", minval=0, maxval=1, step=0.05, group="04 Candle Behaviour / 蠟燭行為")
minUpperWickRatio = input.float(0.35, "Minimum Upper Wick Ratio / 最低上影線比例", minval=0, maxval=1, step=0.05, group="04 Candle Behaviour / 蠟燭行為")
minWickToBodyRatio = input.float(1.5, "Minimum Wick To Body Ratio / 最低影線對實體比例", minval=0, step=0.1, group="04 Candle Behaviour / 蠟燭行為")
minBullishCloseLocation = input.float(0.65, "Bullish Close Location Min / 牛向收市位置最低", minval=0, maxval=1, step=0.05, group="04 Candle Behaviour / 蠟燭行為")
maxBearishCloseLocation = input.float(0.35, "Bearish Close Location Max / 熊向收市位置最高", minval=0, maxval=1, step=0.05, group="04 Candle Behaviour / 蠟燭行為")
longWickThreshold = input.float(0.45, "Long Wick Threshold / 長影線門檻", minval=0, maxval=1, step=0.05, group="04 Candle Behaviour / 蠟燭行為")
dojiBodyThreshold = input.float(0.12, "Doji Body Threshold / 十字星實體門檻", minval=0, maxval=1, step=0.01, group="04 Candle Behaviour / 蠟燭行為")
