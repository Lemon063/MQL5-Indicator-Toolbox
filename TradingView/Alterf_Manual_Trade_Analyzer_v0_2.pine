bodyExpansionThreshold = input.float(1.35, "Body Expansion Threshold / 實體擴張門檻", minval=0.1, step=0.05, group="04 Candle Behaviour / 蠟燭行為")
bullishStrongCloseThreshold = input.float(0.65, "Bullish Strong Close Threshold / 牛向強收市門檻", minval=0, maxval=1, step=0.05, group="04 Candle Behaviour / 蠟燭行為")
bearishStrongCloseThreshold = input.float(0.35, "Bearish Strong Close Threshold / 熊向強收市門檻", minval=0, maxval=1, step=0.05, group="04 Candle Behaviour / 蠟燭行為")

