newsCurrency = input.string("USD", "Event Currency / 新聞貨幣", group="13 Manual News / 人手新聞")
newsImpact = input.string("High", "Event Impact / 新聞影響", options=["Low", "Medium", "High"], group="13 Manual News / 人手新聞")
newsExpectedDirection = input.string("Neutral", "Expected Direction / 預期方向", options=["Bullish", "Bearish", "Neutral"], group="13 Manual News / 人手新聞")
newsWindowBeforeMinutes = input.int(15, "Event Window Before Minutes / 新聞前窗口分鐘", minval=0, group="13 Manual News / 人手新聞")
newsWindowAfterMinutes = input.int(45, "Event Window After Minutes / 新聞後窗口分鐘", minval=1, group="13 Manual News / 人手新聞")
newsFadeThreshold = input.float(0.50, "News Fade Ratio Threshold / 新聞回吐比例門檻", minval=0.0, step=0.05, group="13 Manual News / 人手新聞")
newsDivergencePersistenceBars = input.int(20, "News Divergence Persistence Bars / 新聞背馳持續支數", minval=1, maxval=200, group="13 Manual News / 人手新聞")

enableAlerts = input.bool(true, "Enable Checkpoint Alerts / 啟用檢查點警報", group="14 Alerts / 警報")
confirmedAlertsOnly = input.bool(true, "Confirmed Bar Alerts Only / 只用已確認K線警報", group="14 Alerts / 警報")
alertContextualCandleEvidence = input.bool(false, "Alert Contextual Candle Evidence / 警報背景蠟燭證據", group="14 Alerts / 警報")

validationCaseId = input.string("", "Validation Case ID / 驗證案例 ID", group="15 Bar Replay Validation / Bar Replay 驗證")
manualExpectedInterpretation = input.string("", "Manual Expected Interpretation / 人手預期解讀", group="15 Bar Replay Validation / Bar Replay 驗證")
manualExpectedDirection = input.string("", "Manual Expected Direction / 人手預期方向", group="15 Bar Replay Validation / Bar Replay 驗證")
manualNotes = input.string("", "Manual Notes / 人手筆記", group="15 Bar Replay Validation / Bar Replay 驗證")
showValidationComparison = input.bool(false, "Show Validation Comparison / 顯示驗證比較", group="15 Bar Replay Validation / Bar Replay 驗證")

cleanMode = displayMode == DISPLAY_CLEAN
validationMode = displayMode == DISPLAY_VALIDATION
fullDebugMode = displayMode == DISPLAY_FULL_DEBUG

// ============================================================================
// 02. SHARED PRICE CALCULATIONS
// 共用價格計算
// ============================================================================

f_safeDiv(float numerator, float denominator, float fallback) =>
    denominator == 0.0 or na(denominator) or na(numerator) ? fallback : numerator / denominator

f_clamp(float value, float minimum, float maximum) =>
    math.max(minimum, math.min(maximum, value))

f_norm01(float value, float minimum, float maximum) =>
    maximum == minimum ? 0.0 : f_clamp((value - minimum) / (maximum - minimum), 0.0, 1.0)

f_dirText(int direction) =>
    direction > 0 ? DIR_BULL : direction < 0 ? DIR_BEAR : DIR_NEUTRAL

f_boolScore(bool condition) =>
    condition ? 1.0 : 0.0

f_boolCode(bool condition) =>
    condition ? 1 : 0

f_directionCode(string direction) =>
    direction == DIR_BULL ? 1 : direction == DIR_BEAR ? -1 : direction == DIR_NEUTRAL ? 0 : 99

f_breakoutStateCode(string state) =>
    state == STATE_IDLE ? 0 : state == STATE_APPROACH ? 1 : state == STATE_BREAK ? 2 : state == STATE_WAIT_FT ? 3 : state == STATE_CONFIRMED ? 4 : state == STATE_FAILED ? 5 : state == STATE_WAIT_RETEST ? 6 : state == STATE_RETEST ? 7 : state == STATE_RETEST_HOLD ? 8 : state == STATE_RETEST_FAIL ? 9 : state == STATE_EXPIRED ? 10 : 99

f_interpretationCode(string interpretation) =>
    interpretation == INTERP_NONE ? 0 : interpretation == INTERP_HEALTHY ? 1 : interpretation == INTERP_MESSY ? 2 : interpretation == INTERP_BO_STRONG ? 3 : interpretation == INTERP_BO_WEAK ? 4 : interpretation == INTERP_FAILED_BO ? 5 : interpretation == INTERP_RETEST_HOLD ? 6 : interpretation == INTERP_RETEST_FAIL ? 7 : interpretation == INTERP_PULLBACK_ORDERLY ? 8 : interpretation == INTERP_PULLBACK_MESSY ? 9 : interpretation == INTERP_MOMENTUM_ACCEL ? 10 : interpretation == INTERP_MOMENTUM_SLOW ? 11 : interpretation == INTERP_EXHAUSTION ? 12 : interpretation == INTERP_SECOND_PUSH ? 13 : interpretation == INTERP_FAILED_CONT ? 14 : interpretation == INTERP_CONFLICTING ? 15 : interpretation == INTERP_INSUFFICIENT ? 16 : interpretation == INTERP_RULE_UNDEFINED ? 17 : 99

f_regimeCode(string regime) =>
    regime == REGIME_TREND ? 1 : regime == REGIME_CONSOLIDATION ? 2 : regime == REGIME_BREAKOUT ? 3 : regime == REGIME_MESSY ? 4 : regime == REGIME_TRANSITION ? 5 : 99

f_momentumCode(string state) =>
    state == "ACCELERATING" ? 1 : state == "HEALTHY_CONTINUATION" ? 2 : state == "SLOWING" ? 3 : state == "EXHAUSTION_CANDIDATE" ? 4 : state == "REVERSING" ? 5 : state == "UNRESOLVED" ? 0 : 99

f_sessionCode(string session) =>
    session == "OUT_OF_DEFINED_SESSIONS" ? 0 : session == "PRE_LONDON" ? 1 : session == "LONDON_OPEN" ? 2 : session == "LONDON_MID" ? 3 : session == "LONDON_LATE" ? 4 : session == "LONDON_NEW_YORK_OVERLAP" ? 5 : session == "NEW_YORK_OPEN" ? 6 : session == "NEW_YORK_SESSION" ? 7 : session == "POST_LONDON_CLOSE_DECLINE" ? 8 : session == "ASIAN_OVERNIGHT" ? 9 : 99

f_profileStatusCode(string status) =>
    status == STATUS_IMPLEMENTED ? 1 : status == STATUS_PARTIAL ? 2 : status == STATUS_PLACEHOLDER ? 3 : status == STATUS_NOT_POSSIBLE ? 4 : 99

f_jsonString(string value) =>
    "\"" + str.replace_all(str.replace_all(str.replace_all(str.replace_all(value, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n"), "\t", "\\t") + "\""

barRange = high - low
barBody = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
bodyRatio = f_safeDiv(barBody, barRange, 0.0)
upperWickRatio = f_safeDiv(upperWick, barRange, 0.0)
lowerWickRatio = f_safeDiv(lowerWick, barRange, 0.0)
closeLocation = f_safeDiv(close - low, barRange, 0.5)
bullishProgress = math.max(close - close[1], 0.0)
bearishProgress = math.max(close[1] - close, 0.0)
candleDirection = close > open ? 1 : close < open ? -1 : 0
atrValue = ta.atr(atrLength)
levelTolerance = atrValue * levelToleranceAtr
approachTolerance = atrValue * approachToleranceAtr
breakoutBuffer = atrValue * breakoutBufferAtr
retestTolerance = atrValue * retestToleranceAtr
medianRange = ta.median(barRange, momentumLookback)
medianBody = ta.median(barBody, momentumLookback)
rangeExpansionRatio = f_safeDiv(barRange, medianRange, 0.0)
bodyExpansionRatio = f_safeDiv(barBody, medianBody, 0.0)

// Returns true only when N closes move consecutively in one direction.
// 只喺 N 支收市價連續同方向移動時回傳 true。
f_consecutiveCloses(int bars, int direction) =>
    bool ok = true
    for i = 0 to bars - 2
        ok := ok and (direction > 0 ? close[i] > close[i + 1] : close[i] < close[i + 1])
    ok

// ============================================================================
// 03. MULTI-TIMEFRAME CONFIRMED DATA
// 多時間框架已確認資料
// ============================================================================

// Calculates structure and evidence inside the requested timeframe.
// 喺指定時間框架內計算結構與中間證據。
f_tfMetrics() =>
    float ph = ta.pivothigh(high, swingLeft, swingRight)
    float pl = ta.pivotlow(low, swingLeft, swingRight)
    float latestHigh = ta.valuewhen(not na(ph), ph, 0)
    float previousHigh = ta.valuewhen(not na(ph), ph, 1)
    float latestLow = ta.valuewhen(not na(pl), pl, 0)
    float previousLow = ta.valuewhen(not na(pl), pl, 1)
    int structureDirection = not na(latestHigh) and not na(previousHigh) and not na(latestLow) and not na(previousLow) ? latestHigh > previousHigh and latestLow > previousLow ? 1 : latestHigh < previousHigh and latestLow < previousLow ? -1 : 0 : 0
    float path = math.sum(math.abs(close - close[1]), structureLookback)[1]
    float efficiency = f_safeDiv(math.abs(close[1] - close[structureLookback + 1]), path, 0.0)
    float bullishCloseRatio = f_safeDiv(math.sum(close > close[1] ? 1.0 : 0.0, structureLookback)[1], structureLookback, 0.0)
    float bearishCloseRatio = f_safeDiv(math.sum(close < close[1] ? 1.0 : 0.0, structureLookback)[1], structureLookback, 0.0)
    [open[1], high[1], low[1], close[1], volume[1], time[1], structureDirection, latestHigh, latestLow, efficiency, bullishCloseRatio, bearishCloseRatio, high[1] - low[1], ta.atr(atrLength)[1]]

[m5ConfirmedOpen, m5ConfirmedHigh, m5ConfirmedLow, m5ConfirmedClose, m5ConfirmedVolume, m5ConfirmedTime, m5Direction, m5SwingHigh, m5SwingLow, m5Efficiency, m5BullCloseRatio, m5BearCloseRatio, m5Range, m5Atr] = request.security(syminfo.tickerid, "5", f_tfMetrics(), lookahead=barmerge.lookahead_off)
[m15ConfirmedOpen, m15ConfirmedHigh, m15ConfirmedLow, m15ConfirmedClose, m15ConfirmedVolume, m15ConfirmedTime, m15Direction, m15SwingHigh, m15SwingLow, m15Efficiency, m15BullCloseRatio, m15BearCloseRatio, m15Range, m15Atr] = request.security(syminfo.tickerid, "15", f_tfMetrics(), lookahead=barmerge.lookahead_off)
[m30ConfirmedOpen, m30ConfirmedHigh, m30ConfirmedLow, m30ConfirmedClose, m30ConfirmedVolume, m30ConfirmedTime, m30Direction, m30SwingHigh, m30SwingLow, m30Efficiency, m30BullCloseRatio, m30BearCloseRatio, m30Range, m30Atr] = request.security(syminfo.tickerid, "30", f_tfMetrics(), lookahead=barmerge.lookahead_off)
[h1ConfirmedOpen, h1ConfirmedHigh, h1ConfirmedLow, h1ConfirmedClose, h1ConfirmedVolume, h1ConfirmedTime, h1Direction, h1SwingHigh, h1SwingLow, h1Efficiency, h1BullCloseRatio, h1BearCloseRatio, h1Range, h1Atr] = request.security(syminfo.tickerid, "60", f_tfMetrics(), lookahead=barmerge.lookahead_off)

alignmentWeightTotal = math.max(m5Weight + m15Weight + m30Weight + h1Weight, 0.0001)
alignmentRaw = m5Weight * m5Direction + m15Weight * m15Direction + m30Weight * m30Direction + h1Weight * h1Direction
alignmentScoreSigned = alignmentRaw / alignmentWeightTotal
alignmentScoreAbs = math.abs(alignmentScoreSigned)
timeframeConflictScore = 1.0 - alignmentScoreAbs

// ============================================================================
// 04. MANUAL LEVELS, FIBONACCI AND PRICE LOCATION
// 人手水平、Fibonacci 與價格位置
// ============================================================================

f_distanceToLevel(float level) =>
    close - level

f_normalisedDistance(float level) =>
    f_safeDiv(math.abs(close - level), atrValue, na)

f_nearLevel(float level) =>
    not na(level) and level != 0.0 and math.abs(close - level) <= levelTolerance

fibHigh = math.max(fibAnchorA, fibAnchorB)
fibLow = math.min(fibAnchorA, fibAnchorB)
fibRange = fibHigh - fibLow
fib382 = fibDirection == "Bullish" ? fibHigh - fibRange * 0.382 : fibLow + fibRange * 0.382
fib500 = fibDirection == "Bullish" ? fibHigh - fibRange * 0.500 : fibLow + fibRange * 0.500
fib618 = fibDirection == "Bullish" ? fibHigh - fibRange * 0.618 : fibLow + fibRange * 0.618

vah = profileMode == "Manual" ? manualVah : na
val = profileMode == "Manual" ? manualVal : na
poc = profileMode == "Manual" ? manualPoc : na
profileStatus = profileMode == "Manual" ? STATUS_IMPLEMENTED : STATUS_PARTIAL

float nearestManualLevel = na
string nearestManualSource = "NONE"
float nearestManualDistance = na

f_considerNearest(bool enabled, float level, string source, float currentNearest, float currentDistance) =>
    float candidateDistance = enabled and level != 0.0 ? math.abs(close - level) : na
    bool useCandidate = not na(candidateDistance) and (na(currentDistance) or candidateDistance < currentDistance)
    [useCandidate ? level : currentNearest, useCandidate ? candidateDistance : currentDistance, useCandidate ? source : ""]

[tmpLevel1, tmpDistance1, tmpSource1] = f_considerNearest(manualResistance1Enabled, manualResistance1, "MANUAL_RESISTANCE_1", nearestManualLevel, nearestManualDistance)
nearestManualLevel := tmpLevel1
nearestManualDistance := tmpDistance1
nearestManualSource := tmpSource1 != "" ? tmpSource1 : nearestManualSource
[tmpLevel2, tmpDistance2, tmpSource2] = f_considerNearest(manualResistance2Enabled, manualResistance2, "MANUAL_RESISTANCE_2", nearestManualLevel, nearestManualDistance)
nearestManualLevel := tmpLevel2
nearestManualDistance := tmpDistance2
nearestManualSource := tmpSource2 != "" ? tmpSource2 : nearestManualSource
[tmpLevel3, tmpDistance3, tmpSource3] = f_considerNearest(manualResistance3Enabled, manualResistance3, "MANUAL_RESISTANCE_3", nearestManualLevel, nearestManualDistance)
nearestManualLevel := tmpLevel3
nearestManualDistance := tmpDistance3
nearestManualSource := tmpSource3 != "" ? tmpSource3 : nearestManualSource
[tmpLevel4, tmpDistance4, tmpSource4] = f_considerNearest(manualSupport1Enabled, manualSupport1, "MANUAL_SUPPORT_1", nearestManualLevel, nearestManualDistance)
nearestManualLevel := tmpLevel4
nearestManualDistance := tmpDistance4
nearestManualSource := tmpSource4 != "" ? tmpSource4 : nearestManualSource
[tmpLevel5, tmpDistance5, tmpSource5] = f_considerNearest(manualSupport2Enabled, manualSupport2, "MANUAL_SUPPORT_2", nearestManualLevel, nearestManualDistance)
nearestManualLevel := tmpLevel5
nearestManualDistance := tmpDistance5
nearestManualSource := tmpSource5 != "" ? tmpSource5 : nearestManualSource
[tmpLevel6, tmpDistance6, tmpSource6] = f_considerNearest(manualSupport3Enabled, manualSupport3, "MANUAL_SUPPORT_3", nearestManualLevel, nearestManualDistance)
nearestManualLevel := tmpLevel6
nearestManualDistance := tmpDistance6
nearestManualSource := tmpSource6 != "" ? tmpSource6 : nearestManualSource

nearManualSr = f_nearLevel(manualResistance1) or f_nearLevel(manualResistance2) or f_nearLevel(manualResistance3) or f_nearLevel(manualSupport1) or f_nearLevel(manualSupport2) or f_nearLevel(manualSupport3)
nearManualFib = fibEnabled and (f_nearLevel(fib382) or f_nearLevel(fib500) or f_nearLevel(fib618))
nearVahValPoc = f_nearLevel(vah) or f_nearLevel(val) or f_nearLevel(poc)

// ============================================================================
// 05. PREVIOUS HIGH / LOW AND CONFIRMED SWINGS
// 前高前低與已確認擺動
// ============================================================================

previousDayHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
previousDayLow = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)

inLondon = not na(time(timeframe.period, londonSession, sessionTimezone))
inNewYork = not na(time(timeframe.period, newYorkSession, sessionTimezone))
inAsian = not na(time(timeframe.period, asianSession, sessionTimezone))
inPreLondon = not na(time(timeframe.period, preLondonSession, sessionTimezone))
inLondonOpenWindow = not na(time(timeframe.period, londonOpenSession, sessionTimezone))
inLondonMidWindow = not na(time(timeframe.period, londonMidSession, sessionTimezone))
inLondonLateWindow = not na(time(timeframe.period, londonLateSession, sessionTimezone))
inNewYorkOpenWindow = not na(time(timeframe.period, newYorkOpenSession, sessionTimezone))
inPostLondonWindow = not na(time(timeframe.period, postLondonSession, sessionTimezone))
inOverlap = inLondon and inNewYork

var float londonHigh = na
var float londonLow = na
var float previousLondonHigh = na
var float previousLondonLow = na
var float newYorkHigh = na
var float newYorkLow = na
var float previousNewYorkHigh = na
var float previousNewYorkLow = na

londonStart = inLondon and not inLondon[1]
londonEnd = not inLondon and inLondon[1]
newYorkStart = inNewYork and not inNewYork[1]
newYorkEnd = not inNewYork and inNewYork[1]

if londonStart
    londonHigh := high
    londonLow := low
else if inLondon
    londonHigh := math.max(nz(londonHigh, high), high)
    londonLow := math.min(nz(londonLow, low), low)
if londonEnd
    previousLondonHigh := londonHigh
    previousLondonLow := londonLow

if newYorkStart
    newYorkHigh := high
    newYorkLow := low
else if inNewYork
    newYorkHigh := math.max(nz(newYorkHigh, high), high)
    newYorkLow := math.min(nz(newYorkLow, low), low)
if newYorkEnd
    previousNewYorkHigh := newYorkHigh
    previousNewYorkLow := newYorkLow

previousSessionHigh = inLondon or inAsian ? previousNewYorkHigh : previousLondonHigh
previousSessionLow = inLondon or inAsian ? previousNewYorkLow : previousLondonLow

confirmedSwingHigh = ta.pivothigh(high, swingLeft, swingRight)
confirmedSwingLow = ta.pivotlow(low, swingLeft, swingRight)
latestSwingHigh = ta.valuewhen(not na(confirmedSwingHigh), confirmedSwingHigh, 0)
previousSwingHigh = ta.valuewhen(not na(confirmedSwingHigh), confirmedSwingHigh, 1)
latestSwingLow = ta.valuewhen(not na(confirmedSwingLow), confirmedSwingLow, 0)
previousSwingLow = ta.valuewhen(not na(confirmedSwingLow), confirmedSwingLow, 1)

localStructureDirection = not na(latestSwingHigh) and not na(previousSwingHigh) and not na(latestSwingLow) and not na(previousSwingLow) ? latestSwingHigh > previousSwingHigh and latestSwingLow > previousSwingLow ? 1 : latestSwingHigh < previousSwingHigh and latestSwingLow < previousSwingLow ? -1 : 0 : 0
localStructureText = f_dirText(localStructureDirection)

nearPreviousDay = f_nearLevel(previousDayHigh) or f_nearLevel(previousDayLow)
nearPreviousSession = f_nearLevel(previousSessionHigh) or f_nearLevel(previousSessionLow)

// ============================================================================
// 06. CANDLE BEHAVIOUR ENGINE
// 蠟燭行為分析
// ============================================================================

bullishEngulfing = close[1] < open[1] and close > open and open <= close[1] and close >= open[1]
bearishEngulfing = close[1] > open[1] and close < open and open >= close[1] and close <= open[1]
bullishRejection = lowerWickRatio >= minLowerWickRatio and lowerWick >= barBody * minWickToBodyRatio and closeLocation >= minBullishCloseLocation
bearishRejection = upperWickRatio >= minUpperWickRatio and upperWick >= barBody * minWickToBodyRatio and closeLocation <= maxBearishCloseLocation
longUpperWick = upperWickRatio >= longWickThreshold
longLowerWick = lowerWickRatio >= longWickThreshold
dojiLikeHesitation = bodyRatio <= dojiBodyThreshold
smallBodyHesitation = bodyRatio <= smallBodyThreshold and rangeExpansionRatio >= minSmallBodyRangeExpansion
insideBar = high <= high[1] and low >= low[1]
outsideBar = high >= high[1] and low <= low[1]
consecutiveBullishCloses = f_consecutiveCloses(directionalCloseCount, 1)
consecutiveBearishCloses = f_consecutiveCloses(directionalCloseCount, -1)
consecutiveBullishBodies = math.sum(close > open ? 1.0 : 0.0, directionalCloseCount) == directionalCloseCount
consecutiveBearishBodies = math.sum(close < open ? 1.0 : 0.0, directionalCloseCount) == directionalCloseCount
expansionCandle = rangeExpansionRatio >= rangeExpansionThreshold and bodyExpansionRatio >= bodyExpansionThreshold
weakBullishClose = close > open and closeLocation < bullishStrongCloseThreshold
weakBearishClose = close < open and closeLocation > bearishStrongCloseThreshold
strongBullishClose = close > open and closeLocation >= bullishStrongCloseThreshold
strongBearishClose = close < open and closeLocation <= bearishStrongCloseThreshold
weakCloseEvidence = weakBullishClose or weakBearishClose
strongCloseEvidence = strongBullishClose or strongBearishClose

rawCandleEvidenceSummary = (expansionCandle ? "E " : "") + (bullishEngulfing ? "UE " : "") + (bearishEngulfing ? "BE " : "") + (bullishRejection ? "UR " : "") + (bearishRejection ? "BR " : "") + (weakCloseEvidence ? "W " : "") + (strongCloseEvidence ? "S " : "") + (insideBar ? "I " : "") + (outsideBar ? "O " : "") + (dojiLikeHesitation ? "D " : "") + (smallBodyHesitation ? "H " : "")
currentCandlePattern = bullishEngulfing ? "BULLISH_ENGULFING" : bearishEngulfing ? "BEARISH_ENGULFING" : bullishRejection ? "BULLISH_REJECTION" : bearishRejection ? "BEARISH_REJECTION" : dojiLikeHesitation ? "DOJI_LIKE_HESITATION" : smallBodyHesitation ? "SMALL_BODY_HESITATION" : insideBar ? "INSIDE_BAR" : outsideBar ? "OUTSIDE_BAR" : expansionCandle ? "EXPANSION_CANDLE" : weakCloseEvidence ? "WEAK_CLOSE" : strongCloseEvidence ? "STRONG_CLOSE" : "NONE"
strongRejection = bullishRejection or bearishRejection

// ============================================================================
// 07. CONSOLIDATION EVIDENCE AND FROZEN BOUNDARIES
// 整固證據與凍結邊界
// ============================================================================

windowHigh = ta.highest(high, consolidationLookback)
windowLow = ta.lowest(low, consolidationLookback)
windowRange = windowHigh - windowLow
normalisedWindowRange = f_safeDiv(windowRange, atrValue, 999.0)
netProgress = math.abs(close - close[consolidationLookback - 1])
totalPath = math.sum(math.abs(close - close[1]), consolidationLookback)
efficiencyRatio = f_safeDiv(netProgress, totalPath, 0.0)
overlap = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
minimumRange = math.min(barRange, barRange[1])
overlapRatio = f_safeDiv(overlap, minimumRange, 0.0)
averageOverlapRatio = ta.sma(overlapRatio, consolidationLookback)
directionChanged = candleDirection != 0 and candleDirection[1] != 0 and candleDirection != candleDirection[1]
directionChangeRatio = f_safeDiv(math.sum(directionChanged ? 1.0 : 0.0, consolidationLookback), math.max(consolidationLookback - 1, 1), 0.0)
consolidationCandidate = efficiencyRatio <= maxConsolidationEfficiency and averageOverlapRatio >= minOverlapThreshold and normalisedWindowRange <= maxWindowRangeAtr and directionChangeRatio >= minDirectionChangeRatio

var float frozenConsolidationHigh = na
var float frozenConsolidationLow = na
var int frozenConsolidationBar = na
var bool consolidationFrozen = false

if consolidationCandidate and not consolidationFrozen
    frozenConsolidationHigh := windowHigh
    frozenConsolidationLow := windowLow
    frozenConsolidationBar := bar_index

nearConsolidationBoundary = f_nearLevel(frozenConsolidationHigh) or f_nearLevel(frozenConsolidationLow)

// ============================================================================
// 08. BREAKOUT LEVEL SELECTION AND LIFECYCLE
// 突破水平選擇與生命週期
// ============================================================================

float selectedBreakoutLevel = na
string selectedBreakoutSource = "NONE"
int selectedBreakoutDirection = 0
float selectedDistance = na

f_considerBreakLevel(bool enabled, float level, string source, int direction, float currentLevel, float currentDistance) =>
    float candidateDistance = enabled and not na(level) and level != 0.0 ? math.abs(close - level) : na
    bool useCandidate = not na(candidateDistance) and (na(currentDistance) or candidateDistance < currentDistance)
    [useCandidate ? level : currentLevel, useCandidate ? candidateDistance : currentDistance, useCandidate ? source : "", useCandidate ? direction : 0]

[bl1, bd1, bs1, bdir1] = f_considerBreakLevel(manualResistance1Enabled, manualResistance1, "MANUAL_RESISTANCE_1", 1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl1
selectedDistance := bd1
selectedBreakoutSource := bs1 != "" ? bs1 : selectedBreakoutSource
selectedBreakoutDirection := bdir1 != 0 ? bdir1 : selectedBreakoutDirection
[bl2, bd2, bs2, bdir2] = f_considerBreakLevel(manualResistance2Enabled, manualResistance2, "MANUAL_RESISTANCE_2", 1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl2
selectedDistance := bd2
selectedBreakoutSource := bs2 != "" ? bs2 : selectedBreakoutSource
selectedBreakoutDirection := bdir2 != 0 ? bdir2 : selectedBreakoutDirection
[bl3, bd3, bs3, bdir3] = f_considerBreakLevel(manualResistance3Enabled, manualResistance3, "MANUAL_RESISTANCE_3", 1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl3
selectedDistance := bd3
selectedBreakoutSource := bs3 != "" ? bs3 : selectedBreakoutSource
selectedBreakoutDirection := bdir3 != 0 ? bdir3 : selectedBreakoutDirection
[bl4, bd4, bs4, bdir4] = f_considerBreakLevel(manualSupport1Enabled, manualSupport1, "MANUAL_SUPPORT_1", -1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl4
selectedDistance := bd4
selectedBreakoutSource := bs4 != "" ? bs4 : selectedBreakoutSource
selectedBreakoutDirection := bdir4 != 0 ? bdir4 : selectedBreakoutDirection
[bl5, bd5, bs5, bdir5] = f_considerBreakLevel(manualSupport2Enabled, manualSupport2, "MANUAL_SUPPORT_2", -1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl5
selectedDistance := bd5
selectedBreakoutSource := bs5 != "" ? bs5 : selectedBreakoutSource
selectedBreakoutDirection := bdir5 != 0 ? bdir5 : selectedBreakoutDirection
[bl6, bd6, bs6, bdir6] = f_considerBreakLevel(manualSupport3Enabled, manualSupport3, "MANUAL_SUPPORT_3", -1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl6
selectedDistance := bd6
selectedBreakoutSource := bs6 != "" ? bs6 : selectedBreakoutSource
selectedBreakoutDirection := bdir6 != 0 ? bdir6 : selectedBreakoutDirection
[bl7, bd7, bs7, bdir7] = f_considerBreakLevel(fibEnabled, fib382, "MANUAL_FIB_38_2", fibDirection == "Bullish" ? -1 : 1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl7
selectedDistance := bd7
selectedBreakoutSource := bs7 != "" ? bs7 : selectedBreakoutSource
selectedBreakoutDirection := bdir7 != 0 ? bdir7 : selectedBreakoutDirection
[bl8, bd8, bs8, bdir8] = f_considerBreakLevel(fibEnabled, fib500, "MANUAL_FIB_50_0", fibDirection == "Bullish" ? -1 : 1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl8
selectedDistance := bd8
selectedBreakoutSource := bs8 != "" ? bs8 : selectedBreakoutSource
selectedBreakoutDirection := bdir8 != 0 ? bdir8 : selectedBreakoutDirection
[bl9, bd9, bs9, bdir9] = f_considerBreakLevel(fibEnabled, fib618, "MANUAL_FIB_61_8", fibDirection == "Bullish" ? -1 : 1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl9
selectedDistance := bd9
selectedBreakoutSource := bs9 != "" ? bs9 : selectedBreakoutSource
selectedBreakoutDirection := bdir9 != 0 ? bdir9 : selectedBreakoutDirection
[bl10, bd10, bs10, bdir10] = f_considerBreakLevel(true, previousDayHigh, "PREVIOUS_DAY_HIGH", 1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl10
selectedDistance := bd10
selectedBreakoutSource := bs10 != "" ? bs10 : selectedBreakoutSource
selectedBreakoutDirection := bdir10 != 0 ? bdir10 : selectedBreakoutDirection
[bl11, bd11, bs11, bdir11] = f_considerBreakLevel(true, previousDayLow, "PREVIOUS_DAY_LOW", -1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl11
selectedDistance := bd11
selectedBreakoutSource := bs11 != "" ? bs11 : selectedBreakoutSource
selectedBreakoutDirection := bdir11 != 0 ? bdir11 : selectedBreakoutDirection
[bl12, bd12, bs12, bdir12] = f_considerBreakLevel(true, previousSessionHigh, "PREVIOUS_SESSION_HIGH", 1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl12
selectedDistance := bd12
selectedBreakoutSource := bs12 != "" ? bs12 : selectedBreakoutSource
selectedBreakoutDirection := bdir12 != 0 ? bdir12 : selectedBreakoutDirection
[bl13, bd13, bs13, bdir13] = f_considerBreakLevel(true, previousSessionLow, "PREVIOUS_SESSION_LOW", -1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl13
selectedDistance := bd13
selectedBreakoutSource := bs13 != "" ? bs13 : selectedBreakoutSource
selectedBreakoutDirection := bdir13 != 0 ? bdir13 : selectedBreakoutDirection
[bl14, bd14, bs14, bdir14] = f_considerBreakLevel(true, latestSwingHigh, "CONFIRMED_SWING_HIGH", 1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl14
selectedDistance := bd14
selectedBreakoutSource := bs14 != "" ? bs14 : selectedBreakoutSource
selectedBreakoutDirection := bdir14 != 0 ? bdir14 : selectedBreakoutDirection
[bl15, bd15, bs15, bdir15] = f_considerBreakLevel(true, latestSwingLow, "CONFIRMED_SWING_LOW", -1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl15
selectedDistance := bd15
selectedBreakoutSource := bs15 != "" ? bs15 : selectedBreakoutSource
selectedBreakoutDirection := bdir15 != 0 ? bdir15 : selectedBreakoutDirection
[bl16, bd16, bs16, bdir16] = f_considerBreakLevel(not na(frozenConsolidationHigh), frozenConsolidationHigh, "CONSOLIDATION_HIGH", 1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl16
selectedDistance := bd16
selectedBreakoutSource := bs16 != "" ? bs16 : selectedBreakoutSource
selectedBreakoutDirection := bdir16 != 0 ? bdir16 : selectedBreakoutDirection
[bl17, bd17, bs17, bdir17] = f_considerBreakLevel(not na(frozenConsolidationLow), frozenConsolidationLow, "CONSOLIDATION_LOW", -1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl17
selectedDistance := bd17
selectedBreakoutSource := bs17 != "" ? bs17 : selectedBreakoutSource
selectedBreakoutDirection := bdir17 != 0 ? bdir17 : selectedBreakoutDirection
[bl18, bd18, bs18, bdir18] = f_considerBreakLevel(not na(vah), vah, "VAH", 1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl18
selectedDistance := bd18
selectedBreakoutSource := bs18 != "" ? bs18 : selectedBreakoutSource
selectedBreakoutDirection := bdir18 != 0 ? bdir18 : selectedBreakoutDirection
[bl19, bd19, bs19, bdir19] = f_considerBreakLevel(not na(val), val, "VAL", -1, selectedBreakoutLevel, selectedDistance)
selectedBreakoutLevel := bl19
selectedDistance := bd19
selectedBreakoutSource := bs19 != "" ? bs19 : selectedBreakoutSource
selectedBreakoutDirection := bdir19 != 0 ? bdir19 : selectedBreakoutDirection

levelApproach = not na(selectedBreakoutLevel) and math.abs(close - selectedBreakoutLevel) <= approachTolerance
bullishLevelBreak = selectedBreakoutDirection > 0 and close[1] <= selectedBreakoutLevel and close > selectedBreakoutLevel + breakoutBuffer
bearishLevelBreak = selectedBreakoutDirection < 0 and close[1] >= selectedBreakoutLevel and close < selectedBreakoutLevel - breakoutBuffer
levelBreak = bullishLevelBreak or bearishLevelBreak
wickBreak = selectedBreakoutDirection > 0 ? high > selectedBreakoutLevel and close <= selectedBreakoutLevel : selectedBreakoutDirection < 0 ? low < selectedBreakoutLevel and close >= selectedBreakoutLevel : false
breakDistance = selectedBreakoutDirection > 0 ? close - selectedBreakoutLevel : selectedBreakoutDirection < 0 ? selectedBreakoutLevel - close : 0.0
normalisedBreakDistance = f_safeDiv(breakDistance, atrValue, 0.0)

bodyQuality = f_clamp(bodyRatio / math.max(minBodyRatio, 0.0001), 0.0, 1.0)
closeQuality = selectedBreakoutDirection > 0 ? closeLocation : selectedBreakoutDirection < 0 ? 1.0 - closeLocation : 0.0
breakDistanceQuality = f_clamp(normalisedBreakDistance / math.max(breakDistanceQualityFullAtr, 0.0001), 0.0, 1.0)
expansionQuality = f_clamp((rangeExpansionRatio + bodyExpansionRatio) / 2.0 / math.max(rangeExpansionThreshold, 0.0001), 0.0, 1.0)
oppositeWickPenalty = selectedBreakoutDirection > 0 ? upperWickRatio : selectedBreakoutDirection < 0 ? lowerWickRatio : 0.0
breakoutQualityRaw = breakoutBodyWeight * bodyQuality + breakoutCloseWeight * closeQuality + breakoutDistanceWeight * breakDistanceQuality + breakoutExpansionWeight * expansionQuality - breakoutWickPenaltyWeight * oppositeWickPenalty
breakoutWeightTotal = math.max(breakoutBodyWeight + breakoutCloseWeight + breakoutDistanceWeight + breakoutExpansionWeight, 0.0001)
breakoutQualityScore = f_clamp(breakoutQualityRaw / breakoutWeightTotal, 0.0, 1.0)
breakoutCandidate = levelBreak and breakoutQualityScore >= breakoutCandidateThreshold

var string breakoutState = STATE_IDLE
var float activeBreakoutLevel = na
var string activeBreakoutSource = "NONE"
var int activeBreakoutDirection = 0
var int activeBreakoutCreationBar = na
var int activeBreakoutCreationTime = na
var float activeConsolidationHigh = na
var float activeConsolidationLow = na
var int breakoutAttemptCount = 0
var int failedBreakCount = 0
var string followThroughResult = "NONE"
var float activeBreakoutQualityScore = na
var bool activeBreakoutCandidateQualified = false
var int consecutiveOutsideCloses = 0
var int breakoutAttemptId = 0
var int breakoutBarIndex = na
var int breakoutBarTime = na
var int followThroughEvaluatedAttemptId = na
var int followThroughAlertedAttemptId = na
var string followThroughAlertedEvent = "NONE"
var int followThroughAlertedBar = na
var string transitionPreviousState = "NONE"
var string transitionNewState = "NONE"
var int transitionTime = na
var float transitionPrice = na
var string transitionTrigger = "NONE"
var float transitionRelevantLevel = na
var string transitionTimeframe = timeframe.period

previousBreakoutState = breakoutState
breakoutAge = na(activeBreakoutCreationBar) ? 0 : bar_index - activeBreakoutCreationBar
barOffsetFromBreakout = na(breakoutBarIndex) ? na : bar_index - breakoutBarIndex
outsideActiveLevel = activeBreakoutDirection > 0 ? close > activeBreakoutLevel : activeBreakoutDirection < 0 ? close < activeBreakoutLevel : false
insideOldRange = activeBreakoutDirection > 0 ? close < activeBreakoutLevel : activeBreakoutDirection < 0 ? close > activeBreakoutLevel : false
secondBarProgress = activeBreakoutDirection > 0 ? close > close[1] : activeBreakoutDirection < 0 ? close < close[1] : false
strongDirectionalClose = activeBreakoutDirection > 0 ? closeLocation >= minBullishCloseLocation : activeBreakoutDirection < 0 ? closeLocation <= maxBearishCloseLocation : false
strongOppositeRejection = activeBreakoutDirection > 0 ? bearishRejection : activeBreakoutDirection < 0 ? bullishRejection : false
strongFollowThrough = breakoutState == STATE_BREAK and activeBreakoutCandidateQualified and barOffsetFromBreakout == 1 and secondBarProgress and outsideActiveLevel and strongDirectionalClose and not strongOppositeRejection
weakFollowThrough = breakoutState == STATE_BREAK and activeBreakoutCandidateQualified and barOffsetFromBreakout == 1 and outsideActiveLevel and not strongOppositeRejection and not strongFollowThrough
noFollowThrough = breakoutState == STATE_BREAK and barOffsetFromBreakout == 1 and not outsideActiveLevel and not insideOldRange
immediateFailure = breakoutState == STATE_BREAK and barOffsetFromBreakout == 1 and insideOldRange
followThroughEvaluatedThisBar = false
followThroughEventThisBar = false
lifecycleResetPending = breakoutState == STATE_EXPIRED and barstate.isconfirmed
transitionOccurredThisBar = false
string breakoutTransitionTrigger = "NONE"
float breakoutTransitionLevel = activeBreakoutLevel
string breakoutStateBeforeTransition = breakoutState

if barstate.isconfirmed and breakoutState != STATE_IDLE and breakoutState != STATE_EXPIRED
    consecutiveOutsideCloses := outsideActiveLevel ? consecutiveOutsideCloses + 1 : 0

if lifecycleResetPending
    breakoutTransitionTrigger := "LIFECYCLE_RESET"
    breakoutTransitionLevel := activeBreakoutLevel
    breakoutState := STATE_IDLE
    activeBreakoutLevel := na
    activeBreakoutSource := "NONE"
    activeBreakoutDirection := 0
    activeBreakoutCreationBar := na
    activeBreakoutCreationTime := na
    activeConsolidationHigh := na
    activeConsolidationLow := na
    activeBreakoutQualityScore := na
    activeBreakoutCandidateQualified := false
    breakoutBarIndex := na
    breakoutBarTime := na
    breakoutAge := 0
    barOffsetFromBreakout := na
    consecutiveOutsideCloses := 0
    followThroughResult := "NONE"
    followThroughEvaluatedAttemptId := na
    consolidationFrozen := false
else if barstate.isconfirmed and breakoutState != STATE_IDLE and breakoutAge > stateExpiryBars
    breakoutState := STATE_EXPIRED
    breakoutTransitionTrigger := "STATE_EXPIRY"
    consolidationFrozen := false
else if barstate.isconfirmed and (breakoutState == STATE_IDLE or breakoutState == STATE_APPROACH) and levelBreak
    breakoutState := STATE_BREAK
    breakoutTransitionTrigger := "LEVEL_BREAK"
    activeBreakoutLevel := selectedBreakoutLevel
    activeBreakoutSource := selectedBreakoutSource
    activeBreakoutDirection := selectedBreakoutDirection
    activeBreakoutCreationBar := bar_index
    activeBreakoutCreationTime := time
    breakoutBarIndex := bar_index
    breakoutBarTime := time
    activeConsolidationHigh := frozenConsolidationHigh
    activeConsolidationLow := frozenConsolidationLow
    activeBreakoutQualityScore := breakoutQualityScore
    activeBreakoutCandidateQualified := breakoutCandidate
    consecutiveOutsideCloses := 1
    followThroughResult := "NONE"
    followThroughEvaluatedAttemptId := na
    consolidationFrozen := true
    breakoutAttemptCount += 1
    breakoutAttemptId += 1
else if barstate.isconfirmed and breakoutState == STATE_IDLE and levelApproach
    breakoutState := STATE_APPROACH
    breakoutTransitionTrigger := "APPROACH_TOLERANCE"
else if barstate.isconfirmed and breakoutState == STATE_BREAK and barOffsetFromBreakout == 1
    followThroughEvaluatedThisBar := true
    followThroughEvaluatedAttemptId := breakoutAttemptId
    if strongFollowThrough
        followThroughResult := "STRONG_FOLLOW_THROUGH"
        breakoutState := STATE_CONFIRMED
        breakoutTransitionTrigger := "SECOND_BAR_STRONG_FOLLOW_THROUGH"
        followThroughEventThisBar := true
    else if weakFollowThrough
        followThroughResult := "WEAK_FOLLOW_THROUGH"
        breakoutState := STATE_WAIT_FT
        breakoutTransitionTrigger := "SECOND_BAR_WEAK_FOLLOW_THROUGH"
        followThroughEventThisBar := true
    else if immediateFailure
        followThroughResult := "IMMEDIATE_FAILURE"
        breakoutState := STATE_FAILED
        breakoutTransitionTrigger := "SECOND_BAR_IMMEDIATE_FAILURE"
        followThroughEventThisBar := true
        failedBreakCount += 1
    else if noFollowThrough
        followThroughResult := "NO_FOLLOW_THROUGH"
        breakoutState := STATE_WAIT_FT
        breakoutTransitionTrigger := "SECOND_BAR_NO_FOLLOW_THROUGH"
        followThroughEventThisBar := true
    else
        followThroughResult := activeBreakoutCandidateQualified ? "UNRESOLVED_SECOND_BAR" : "NOT_A_CANDIDATE"
        breakoutState := STATE_WAIT_FT
        breakoutTransitionTrigger := activeBreakoutCandidateQualified ? "SECOND_BAR_UNRESOLVED" : "BREAKOUT_NOT_CANDIDATE"
        followThroughEventThisBar := true
else if barstate.isconfirmed and breakoutState == STATE_WAIT_FT
    bool routeBConfirmed = consecutiveOutsideCloses >= followThroughBars
    bool routeFailed = breakoutAge <= maxFailureBars and insideOldRange
    if routeBConfirmed
        breakoutState := STATE_CONFIRMED
        breakoutTransitionTrigger := "CONSECUTIVE_OUTSIDE_CLOSES"
    else if routeFailed
        breakoutState := STATE_FAILED
        breakoutTransitionTrigger := "CLOSE_BACK_INSIDE"
        failedBreakCount += 1
else if barstate.isconfirmed and breakoutState == STATE_CONFIRMED and breakoutAge >= 1
    breakoutState := STATE_WAIT_RETEST
    breakoutTransitionTrigger := "CONFIRMED_TO_RETEST_WAIT"
else if barstate.isconfirmed and breakoutState == STATE_WAIT_RETEST
    bool inRetestZone = not na(activeBreakoutLevel) and low <= activeBreakoutLevel + retestTolerance and high >= activeBreakoutLevel - retestTolerance
    if inRetestZone
        breakoutState := STATE_RETEST
        breakoutTransitionTrigger := "PRICE_ENTERED_RETEST_ZONE"
else if barstate.isconfirmed and breakoutState == STATE_RETEST
    bool retestHold = outsideActiveLevel and (activeBreakoutDirection > 0 ? bullishRejection or close > open : bearishRejection or close < open)
    bool retestFail = insideOldRange and (activeBreakoutDirection > 0 ? close < activeBreakoutLevel - retestTolerance : close > activeBreakoutLevel + retestTolerance)
    if retestHold
        breakoutState := STATE_RETEST_HOLD
        breakoutTransitionTrigger := "RETEST_HOLD_EVIDENCE"
    else if retestFail
        breakoutState := STATE_RETEST_FAIL
        breakoutTransitionTrigger := "RETEST_FAIL_EVIDENCE"
        failedBreakCount += 1
if breakoutState == STATE_FAILED or breakoutState == STATE_RETEST_FAIL or breakoutState == STATE_EXPIRED
    consolidationFrozen := false

if breakoutState != breakoutStateBeforeTransition
    transitionOccurredThisBar := true
    transitionPreviousState := breakoutStateBeforeTransition
    transitionNewState := breakoutState
    transitionTime := time
    transitionPrice := close
    transitionTrigger := breakoutTransitionTrigger
    transitionRelevantLevel := breakoutTransitionLevel
    transitionTimeframe := timeframe.period

failedBreakRatio = f_safeDiv(failedBreakCount, breakoutAttemptCount, 0.0)

// ============================================================================
// 09. MOMENTUM CLASSIFICATION
// 動能分類
// ============================================================================

directionalProgress = localStructureDirection >= 0 ? bullishProgress : bearishProgress
previousDirectionalProgress = localStructureDirection >= 0 ? bullishProgress[1] : bearishProgress[1]
selectedProgressSeries = localStructureDirection >= 0 ? bullishProgress : bearishProgress
averagePreviousProgress = f_safeDiv(math.sum(selectedProgressSeries[1], progressDecayLookback), progressDecayLookback, 0.0)
progressDecayRatio = f_safeDiv(directionalProgress, averagePreviousProgress, 0.0)
recentImpulseHigh = ta.highest(high, momentumLookback)
recentImpulseLow = ta.lowest(low, momentumLookback)
impulseDistanceBull = recentImpulseHigh - recentImpulseLow
pullbackDistanceBull = recentImpulseHigh - low
pullbackRatioBull = f_safeDiv(pullbackDistanceBull, impulseDistanceBull, 0.0)
impulseDistanceBear = recentImpulseHigh - recentImpulseLow
pullbackDistanceBear = high - recentImpulseLow
pullbackRatioBear = f_safeDiv(pullbackDistanceBear, impulseDistanceBear, 0.0)
activePullbackRatio = localStructureDirection >= 0 ? pullbackRatioBull : pullbackRatioBear
oppositeWick = localStructureDirection >= 0 ? upperWickRatio : lowerWickRatio
importantLevelContextScore = f_boolScore(nearManualSr) + f_boolScore(nearManualFib) + f_boolScore(nearPreviousDay) + f_boolScore(nearPreviousSession) + f_boolScore(nearVahValPoc) + f_boolScore(nearConsolidationBoundary)

momentumAcceleration = directionalProgress > previousDirectionalProgress and rangeExpansionRatio > rangeExpansionRatio[1] and bodyExpansionRatio > bodyExpansionRatio[1] and (localStructureDirection >= 0 ? closeLocation >= accelerationCloseLocation : closeLocation <= 1.0 - accelerationCloseLocation)
healthyContinuation = localStructureDirection != 0 and (localStructureDirection > 0 ? consecutiveBullishCloses : consecutiveBearishCloses) and activePullbackRatio < deepPullbackRatio and not strongOppositeRejection and directionalProgress > 0
momentumSlowing = directionalProgress < previousDirectionalProgress and barBody < barBody[1] and oppositeWick > oppositeWick[1] and directionalProgress > 0 and progressDecayRatio <= progressDecayThreshold
exhaustionCandidate = importantLevelContextScore > 0 and (rangeExpansionRatio >= rangeExpansionThreshold or oppositeWick >= longWickThreshold) and not strongDirectionalClose and not (localStructureDirection > 0 ? close > close[1] : close < close[1])
reversalCandidate = exhaustionCandidate[1] and (localStructureDirection > 0 ? bearishEngulfing or bearishRejection : bullishEngulfing or bullishRejection) and (localStructureDirection > 0 ? close < latestSwingLow : close > latestSwingHigh) and (localStructureDirection > 0 ? close < close[1] : close > close[1])
momentumState = momentumAcceleration ? "ACCELERATING" : healthyContinuation ? "HEALTHY_CONTINUATION" : momentumSlowing ? "SLOWING" : exhaustionCandidate ? "EXHAUSTION_CANDIDATE" : reversalCandidate ? "REVERSING" : "UNRESOLVED"

// ============================================================================
// 10. MARKET REGIME SCORES
// 市場狀態分數
// ============================================================================

structureScore = localStructureDirection == 0 ? 0.0 : 1.0
efficiencyScore = f_norm01(efficiencyRatio, trendEfficiencyMin, trendEfficiencyMax)
bullishDirectionalCloseRatio = f_safeDiv(math.sum(close > close[1] ? 1.0 : 0.0, structureLookback), structureLookback, 0.0)
bearishDirectionalCloseRatio = f_safeDiv(math.sum(close < close[1] ? 1.0 : 0.0, structureLookback), structureLookback, 0.0)
directionalCloseScore = localStructureDirection >= 0 ? bullishDirectionalCloseRatio : bearishDirectionalCloseRatio
trendWeightTotal = math.max(wStructure + wEfficiency + wAlignment + wDirectional, 0.0001)
trendScore = (wStructure * structureScore + wEfficiency * efficiencyScore + wAlignment * alignmentScoreAbs + wDirectional * directionalCloseScore) / trendWeightTotal

lowEfficiencyScore = 1.0 - f_clamp(efficiencyRatio, 0.0, 1.0)
highOverlapScore = f_clamp(averageOverlapRatio, 0.0, 1.0)
containedRangeScore = 1.0 - f_clamp(normalisedWindowRange / math.max(maxWindowRangeAtr, 0.0001), 0.0, 1.0)
directionChangeScore = f_clamp(directionChangeRatio, 0.0, 1.0)
consoWeightTotal = math.max(wConsoEfficiency + wConsoOverlap + wConsoRange + wConsoChange, 0.0001)
consolidationScore = (wConsoEfficiency * lowEfficiencyScore + wConsoOverlap * highOverlapScore + wConsoRange * containedRangeScore + wConsoChange * directionChangeScore) / consoWeightTotal

alternatingExpansion = candleDirection != 0 and candleDirection[1] != 0 and candleDirection != candleDirection[1] and rangeExpansionRatio >= rangeExpansionThreshold and rangeExpansionRatio[1] >= rangeExpansionThreshold
alternatingExpansionScore = f_boolScore(alternatingExpansion)
failedBreakScore = f_clamp(failedBreakRatio, 0.0, 1.0)
messyWeightTotal = math.max(wMessyChange + wMessyFailedBreak + wMessyConflict + wMessyAlternating, 0.0001)
messyScore = (wMessyChange * directionChangeScore + wMessyFailedBreak * failedBreakScore + wMessyConflict * timeframeConflictScore + wMessyAlternating * alternatingExpansionScore) / messyWeightTotal

activeBreakoutLifecycle = breakoutState != STATE_IDLE and breakoutState != STATE_EXPIRED
currentRegime = activeBreakoutLifecycle ? REGIME_BREAKOUT : trendScore >= trendThreshold ? REGIME_TREND : consolidationScore >= consolidationThreshold ? REGIME_CONSOLIDATION : messyScore >= messyThreshold ? REGIME_MESSY : REGIME_TRANSITION

// ============================================================================
// 11. SESSION CONTEXT
// 交易時段背景
// ============================================================================

currentSession = inOverlap ? "LONDON_NEW_YORK_OVERLAP" : inPreLondon ? "PRE_LONDON" : inLondonOpenWindow ? "LONDON_OPEN" : inLondonMidWindow ? "LONDON_MID" : inLondonLateWindow ? "LONDON_LATE" : inNewYorkOpenWindow ? "NEW_YORK_OPEN" : inNewYork ? "NEW_YORK_SESSION" : inPostLondonWindow ? "POST_LONDON_CLOSE_DECLINE" : inAsian ? "ASIAN_OVERNIGHT" : "OUT_OF_DEFINED_SESSIONS"
var float sessionOpen = na
var float sessionHigh = na
var float sessionLow = na
var float sessionPath = 0.0
var int sessionStartTime = na
var float asianHigh = na
var float asianLow = na
var float previousAsianHigh = na
var float previousAsianLow = na
sessionChanged = currentSession != currentSession[1]
asianStart = inAsian and not inAsian[1]
asianEnd = not inAsian and inAsian[1]
if sessionChanged
    sessionOpen := open
    sessionHigh := high
    sessionLow := low
    sessionPath := math.abs(close - close[1])
    sessionStartTime := time
else
    sessionHigh := math.max(nz(sessionHigh, high), high)
    sessionLow := math.min(nz(sessionLow, low), low)
    sessionPath += math.abs(close - close[1])
if asianStart
    asianHigh := high
    asianLow := low
else if inAsian
    asianHigh := math.max(nz(asianHigh, high), high)
    asianLow := math.min(nz(asianLow, low), low)
if asianEnd
    previousAsianHigh := asianHigh
    previousAsianLow := asianLow
sessionRange = sessionHigh - sessionLow
sessionNetProgress = math.abs(close - sessionOpen)
sessionEfficiency = f_safeDiv(sessionNetProgress, sessionPath, 0.0)
sessionRangeAtr = f_safeDiv(sessionRange, atrValue, na)
sessionNetProgressAtr = f_safeDiv(sessionNetProgress, atrValue, na)
minutesFromSessionStart = na(sessionStartTime) ? na : int(math.floor((time - sessionStartTime) / 60000))
sessionDirection = close > sessionOpen ? DIR_BULL : close < sessionOpen ? DIR_BEAR : DIR_NEUTRAL
sessionHighSwept = not na(sessionHigh[1]) and high > sessionHigh[1]
sessionLowSwept = not na(sessionLow[1]) and low < sessionLow[1]
overnightConsolidation = inAsian and consolidationCandidate and f_safeDiv(sessionRange, atrValue, 999.0) <= maxWindowRangeAtr
londonBreaksAsianHigh = inLondon and not na(previousAsianHigh) and high > previousAsianHigh
londonBreaksAsianLow = inLondon and not na(previousAsianLow) and low < previousAsianLow
closeMomentumDecline = ta.sma(barRange, closeMomentumLookback) < ta.sma(barRange[closeMomentumComparisonOffset], closeMomentumLookback) and progressDecayRatio <= progressDecayThreshold and volume <= volume[1]
postLondonMomentumDecline = inPostLondonWindow and closeMomentumDecline

// ============================================================================
// 12. MANUAL NEWS CONTEXT
// 人手新聞背景
// ============================================================================

newsBeforeMs = newsWindowBeforeMinutes * 60 * 1000
newsAfterMs = newsWindowAfterMinutes * 60 * 1000
preNewsWindow = newsActive and time >= newsEventTime - newsBeforeMs and time < newsEventTime
newsReleaseWindow = newsActive and time >= newsEventTime and time <= newsEventTime + newsAfterMs
postNewsWindow = newsActive and time > newsEventTime + newsAfterMs

var float preNewsClose = na
var float reactionExtreme = na
var int observedReactionDirection = 0
var float initialReactionDistance = na

if newsActive and time < newsEventTime
    preNewsClose := close
if newsActive and time >= newsEventTime and observedReactionDirection == 0 and not na(preNewsClose)
    observedReactionDirection := close > preNewsClose ? 1 : close < preNewsClose ? -1 : 0
    reactionExtreme := close
    initialReactionDistance := math.abs(close - preNewsClose)
if newsActive and time >= newsEventTime and observedReactionDirection != 0
    reactionExtreme := na(reactionExtreme) ? close : observedReactionDirection > 0 ? math.max(reactionExtreme, high) : math.min(reactionExtreme, low)

reactionDistance = not na(preNewsClose) ? math.abs(close - preNewsClose) : na
normalisedReaction = f_safeDiv(reactionDistance, atrValue, na)
expectedDirectionValue = newsExpectedDirection == "Bullish" ? 1 : newsExpectedDirection == "Bearish" ? -1 : 0
newsDivergence = newsActive and expectedDirectionValue != 0 and observedReactionDirection != 0 and expectedDirectionValue != observedReactionDirection
fadeDistance = not na(reactionExtreme) ? math.abs(close - reactionExtreme) : na
fadeRatio = f_safeDiv(fadeDistance, initialReactionDistance, na)
newsFollowThrough = newsReleaseWindow and observedReactionDirection != 0 and (observedReactionDirection > 0 ? close > preNewsClose and close > close[1] : close < preNewsClose and close < close[1])
newsFade = newsReleaseWindow and not na(fadeRatio) and fadeRatio >= newsFadeThreshold
divergencePersistence = f_safeDiv(math.sum(newsDivergence ? 1.0 : 0.0, newsDivergencePersistenceBars), newsDivergencePersistenceBars, 0.0)
newsState = not newsActive ? "INACTIVE" : preNewsWindow ? "PRE_NEWS_WINDOW" : newsReleaseWindow ? newsFollowThrough ? "NEWS_FOLLOW_THROUGH" : newsFade ? "NEWS_FADE" : "NEWS_RELEASE_WINDOW" : postNewsWindow ? "POST_NEWS_REACTION" : "SCHEDULED"

// ============================================================================
// 13. STATE TRANSITION ENGINE
// 狀態轉換引擎
// ============================================================================

var string previousGlobalState = REGIME_TRANSITION
globalState = currentRegime + "|" + breakoutState + "|" + momentumState
regimeOrMomentumTransition = bar_index > 0 and not transitionOccurredThisBar and (currentRegime != currentRegime[1] or momentumState != momentumState[1])
stateTransition = transitionOccurredThisBar or regimeOrMomentumTransition
transitionEvidence = transitionOccurredThisBar ? transitionTrigger : currentRegime != currentRegime[1] ? "REGIME_SCORE_CHANGE" : momentumState != momentumState[1] ? "MOMENTUM_EVIDENCE_CHANGE" : "NONE"
if stateTransition
    previousGlobalState := bar_index > 0 ? globalState[1] : REGIME_TRANSITION
    if regimeOrMomentumTransition
        transitionOccurredThisBar := true
        transitionPreviousState := previousGlobalState
        transitionNewState := globalState
        transitionTime := time
        transitionPrice := close
        transitionTrigger := transitionEvidence
        transitionRelevantLevel := activeBreakoutLevel
        transitionTimeframe := timeframe.period

// ============================================================================
// 14. TRADING LOGIC VALIDATION LAYERS
// 交易邏輯驗證分層
// ============================================================================

evidence_near_manual_level = nearManualSr or nearManualFib
evidence_near_previous_day_level = nearPreviousDay
evidence_near_previous_session_level = nearPreviousSession
evidence_near_consolidation_boundary = nearConsolidationBoundary
evidence_near_value_area_level = nearVahValPoc
evidence_during_breakout_lifecycle = activeBreakoutLifecycle
evidence_after_expansion = expansionCandle[1]
evidence_after_failed_push = momentumSlowing[1] or exhaustionCandidate[1] or weakCloseEvidence[1]
evidence_with_mtf_direction = candleDirection != 0 and alignmentScoreSigned != 0 and candleDirection == (alignmentScoreSigned > 0 ? 1 : -1)
evidence_against_mtf_direction = candleDirection != 0 and alignmentScoreSigned != 0 and candleDirection != (alignmentScoreSigned > 0 ? 1 : -1)
evidence_progress_accelerating = directionalProgress > previousDirectionalProgress and directionalProgress > 0
evidence_progress_declining = directionalProgress < previousDirectionalProgress and previousDirectionalProgress > 0
evidence_range_expanding = rangeExpansionRatio > rangeExpansionRatio[1]
evidence_range_contracting = rangeExpansionRatio < rangeExpansionRatio[1]
evidence_close_quality_improving = closeQuality > closeQuality[1]
evidence_close_quality_weakening = closeQuality < closeQuality[1]
evidence_session_open_phase = currentSession == "LONDON_OPEN" or currentSession == "NEW_YORK_OPEN"
evidence_session_late_phase = currentSession == "LONDON_LATE" or currentSession == "POST_LONDON_CLOSE_DECLINE"
evidence_at_important_level = evidence_near_manual_level or evidence_near_previous_day_level or evidence_near_previous_session_level or evidence_near_consolidation_boundary or evidence_near_value_area_level
evidence_at_decision_checkpoint = transitionOccurredThisBar or followThroughEvaluatedThisBar or breakoutState == STATE_FAILED or breakoutState == STATE_RETEST_HOLD or breakoutState == STATE_RETEST_FAIL
momentumMeaningChanged = momentumState != momentumState[1]

contextualEvidenceSummary = (evidence_near_manual_level ? "NEAR_MANUAL " : "") + (evidence_near_previous_day_level ? "NEAR_PD " : "") + (evidence_near_previous_session_level ? "NEAR_PS " : "") + (evidence_near_consolidation_boundary ? "NEAR_CONSO " : "") + (evidence_near_value_area_level ? "NEAR_VALUE " : "") + (evidence_during_breakout_lifecycle ? "BO_LIFECYCLE " : "") + (evidence_with_mtf_direction ? "WITH_MTF " : "") + (evidence_against_mtf_direction ? "AGAINST_MTF " : "") + (evidence_progress_accelerating ? "PROGRESS_ACCEL " : "") + (evidence_progress_declining ? "PROGRESS_DECLINE " : "") + (evidence_session_open_phase ? "SESSION_OPEN " : "") + (evidence_session_late_phase ? "SESSION_LATE " : "")

supportEvidenceCount = f_boolScore(evidence_with_mtf_direction) + f_boolScore(evidence_progress_accelerating) + f_boolScore(evidence_range_expanding) + f_boolScore(evidence_close_quality_improving) + f_boolScore(strongCloseEvidence) + f_boolScore(evidence_at_important_level) + f_boolScore(evidence_during_breakout_lifecycle)
contradictionEvidenceCount = f_boolScore(evidence_against_mtf_direction) + f_boolScore(evidence_progress_declining) + f_boolScore(evidence_range_contracting) + f_boolScore(evidence_close_quality_weakening) + f_boolScore(weakCloseEvidence) + f_boolScore(timeframeConflictScore >= mtfConflictContradictionThreshold)
orderlyPullbackCandidate = localStructureDirection != 0 and activePullbackRatio > 0 and activePullbackRatio < deepPullbackRatio and evidence_range_contracting and not strongOppositeRejection and currentRegime != REGIME_MESSY
messyPullbackCandidate = localStructureDirection != 0 and activePullbackRatio > 0 and (activePullbackRatio >= deepPullbackRatio or currentRegime == REGIME_MESSY or strongOppositeRejection) and (weakCloseEvidence or evidence_range_expanding or evidence_against_mtf_direction)
secondPushAttemptCandidate = localStructureDirection != 0 and evidence_after_failed_push and evidence_progress_accelerating and (localStructureDirection > 0 ? close > close[1] : close < close[1])
failedContinuationCandidate = localStructureDirection != 0 and (healthyContinuation[1] or momentumAcceleration[1]) and evidence_progress_declining and (weakCloseEvidence or strongOppositeRejection or evidence_against_mtf_direction)

interpretationCandidateName = INTERP_NONE
interpretationCandidateDirection = DIR_UNRESOLVED
interpretationRuleStatus = STATUS_IMPLEMENTED

if breakoutState == STATE_FAILED
    interpretationCandidateName := INTERP_FAILED_BO
    interpretationCandidateDirection := f_dirText(activeBreakoutDirection)
else if breakoutState == STATE_RETEST_HOLD
    interpretationCandidateName := INTERP_RETEST_HOLD
    interpretationCandidateDirection := f_dirText(activeBreakoutDirection)
else if breakoutState == STATE_RETEST_FAIL
    interpretationCandidateName := INTERP_RETEST_FAIL
    interpretationCandidateDirection := f_dirText(activeBreakoutDirection)
else if followThroughResult == "STRONG_FOLLOW_THROUGH"
    interpretationCandidateName := INTERP_BO_STRONG
    interpretationCandidateDirection := f_dirText(activeBreakoutDirection)
else if followThroughResult == "WEAK_FOLLOW_THROUGH" or followThroughResult == "NO_FOLLOW_THROUGH"
    interpretationCandidateName := INTERP_BO_WEAK
    interpretationCandidateDirection := f_dirText(activeBreakoutDirection)
else if followThroughResult == "UNRESOLVED_SECOND_BAR"
    interpretationCandidateName := INTERP_INSUFFICIENT
    interpretationCandidateDirection := DIR_UNRESOLVED
    interpretationRuleStatus := INTERP_RULE_UNDEFINED
else if failedContinuationCandidate
    interpretationCandidateName := INTERP_FAILED_CONT
    interpretationCandidateDirection := f_dirText(localStructureDirection)
else if secondPushAttemptCandidate
    interpretationCandidateName := INTERP_SECOND_PUSH
    interpretationCandidateDirection := f_dirText(localStructureDirection)
else if momentumState == "ACCELERATING"
    interpretationCandidateName := INTERP_MOMENTUM_ACCEL
    interpretationCandidateDirection := f_dirText(localStructureDirection)
else if momentumState == "SLOWING"
    interpretationCandidateName := INTERP_MOMENTUM_SLOW
    interpretationCandidateDirection := f_dirText(localStructureDirection)
else if momentumState == "EXHAUSTION_CANDIDATE"
    interpretationCandidateName := INTERP_EXHAUSTION
    interpretationCandidateDirection := DIR_UNRESOLVED
else if healthyContinuation
    interpretationCandidateName := INTERP_HEALTHY
    interpretationCandidateDirection := f_dirText(localStructureDirection)
else if orderlyPullbackCandidate
    interpretationCandidateName := INTERP_PULLBACK_ORDERLY
    interpretationCandidateDirection := f_dirText(localStructureDirection)
else if messyPullbackCandidate
    interpretationCandidateName := INTERP_PULLBACK_MESSY
    interpretationCandidateDirection := f_dirText(localStructureDirection)
else if currentRegime == REGIME_MESSY and localStructureDirection != 0
    interpretationCandidateName := INTERP_MESSY
    interpretationCandidateDirection := f_dirText(localStructureDirection)
else if contradictionEvidenceCount >= conflictEvidenceThreshold and supportEvidenceCount >= conflictEvidenceThreshold
    interpretationCandidateName := INTERP_CONFLICTING
    interpretationCandidateDirection := DIR_UNRESOLVED
else
    interpretationCandidateName := INTERP_NONE
    interpretationCandidateDirection := DIR_UNRESOLVED
    interpretationRuleStatus := INTERP_RULE_UNDEFINED

implementedRuleMatched = interpretationCandidateName != INTERP_NONE and interpretationCandidateName != INTERP_INSUFFICIENT
candidateConfidenceRaw = interpretationBaseConfidence + supportEvidenceWeight * supportEvidenceCount - contradictionEvidenceWeight * contradictionEvidenceCount + (evidence_during_breakout_lifecycle ? breakoutInterpretationWeight : 0.0) + ((momentumState == "ACCELERATING" or momentumState == "SLOWING" or momentumState == "EXHAUSTION_CANDIDATE") ? momentumInterpretationWeight : 0.0) + (evidence_at_important_level ? contextInterpretationWeight : 0.0)
interpretationCandidateConfidence = implementedRuleMatched ? f_clamp(candidateConfidenceRaw, 0.0, 1.0) : interpretationCandidateName == INTERP_INSUFFICIENT ? f_clamp(interpretationBaseConfidence - contradictionEvidenceWeight, 0.0, 1.0) : 0.0

support_reason_1 = evidence_during_breakout_lifecycle ? "Breakout lifecycle active: " + breakoutState : momentumState == "ACCELERATING" ? "Momentum state accelerating" : momentumState == "SLOWING" ? "Momentum state slowing" : momentumState == "EXHAUSTION_CANDIDATE" ? "Momentum exhaustion candidate evidence" : evidence_with_mtf_direction ? "Current candle direction with MTF alignment" : "INSUFFICIENT_EVIDENCE"
support_reason_2 = followThroughEventThisBar ? "Second-bar follow-through result: " + followThroughResult : orderlyPullbackCandidate ? "Pullback remains below deep pullback threshold" : messyPullbackCandidate ? "Pullback depth or disorder observed" : secondPushAttemptCandidate ? "Second push after failed push evidence" : failedContinuationCandidate ? "Continuation failure evidence after prior continuation" : evidence_at_important_level ? "Evidence near important level" : evidence_progress_accelerating ? "Directional progress accelerating" : evidence_close_quality_improving ? "Close quality improving" : "INSUFFICIENT_EVIDENCE"
support_reason_3 = strongCloseEvidence ? "Strong close raw evidence" : expansionCandle ? "Expansion raw evidence" : evidence_range_expanding ? "Range expanding" : evidence_range_contracting and orderlyPullbackCandidate ? "Range contracting during pullback" : evidence_session_open_phase ? "Session open phase context" : "INSUFFICIENT_EVIDENCE"
contradiction_reason_1 = evidence_against_mtf_direction ? "Current candle direction against MTF alignment" : timeframeConflictScore >= mtfConflictContradictionThreshold ? "MTF conflict score high" : "NONE"
contradiction_reason_2 = evidence_progress_declining ? "Directional progress declining" : evidence_close_quality_weakening ? "Close quality weakening" : weakCloseEvidence ? "Weak close raw evidence" : "NONE"
contradiction_reason_3 = evidence_range_contracting ? "Range contracting" : strongOppositeRejection ? "Opposite rejection near active meaning" : currentRegime == REGIME_MESSY ? "Messy regime context" : "NONE"
missing_evidence_1 = not evidence_at_important_level ? "No important level proximity" : alignmentScoreSigned == 0 ? "MTF direction unresolved" : "NONE"
missing_evidence_2 = interpretationCandidateName == INTERP_INSUFFICIENT ? "Second-bar result unresolved: insufficient evidence" : not evidence_during_breakout_lifecycle and (interpretationCandidateName == INTERP_BO_STRONG or interpretationCandidateName == INTERP_BO_WEAK or interpretationCandidateName == INTERP_FAILED_BO) ? "No active breakout lifecycle" : interpretationCandidateName == INTERP_NONE ? "Rule not defined for current combination" : "NONE"
majorSupportSignature = support_reason_1 + "|" + support_reason_2 + "|" + support_reason_3
majorContradictionSignature = contradiction_reason_1 + "|" + contradiction_reason_2 + "|" + contradiction_reason_3

var string currentInterpretation = INTERP_NONE
var string currentInterpretationDirection = DIR_UNRESOLVED
var string currentInterpretationRuleStatus = INTERP_RULE_UNDEFINED
var float currentInterpretationConfidence = 0.0
var int interpretationCreationTime = na
var int interpretationCreationBarIndex = na
var int interpretationUpdatedTime = na
var int interpretationUpdatedBarIndex = na
var string previousSupportSignature = ""
var string previousContradictionSignature = ""
var string latestInterpretationChangeReason = "INITIAL"

nameChanged = interpretationCandidateName != currentInterpretation
interpDirectionChanged = interpretationCandidateDirection != currentInterpretationDirection
ruleStatusChanged = interpretationRuleStatus != currentInterpretationRuleStatus
confidenceMateriallyChanged = math.abs(interpretationCandidateConfidence - currentInterpretationConfidence) >= minimumInterpretationConfidenceChange
supportMateriallyChanged = majorSupportSignature != previousSupportSignature
contradictionAppeared = majorContradictionSignature != previousContradictionSignature and majorContradictionSignature != "NONE|NONE|NONE"
breakoutMeaningChanged = transitionOccurredThisBar and str.contains(transitionTrigger, "BREAK")
momentumMeaningMateriallyChanged = momentumMeaningChanged and (momentumState == "ACCELERATING" or momentumState == "SLOWING" or momentumState == "EXHAUSTION_CANDIDATE")
interpretationChangedThisBar = barstate.isconfirmed and (nameChanged or interpDirectionChanged or ruleStatusChanged or confidenceMateriallyChanged or supportMateriallyChanged or contradictionAppeared or breakoutMeaningChanged or momentumMeaningMateriallyChanged)

if interpretationChangedThisBar
    bool createdNewInterpretation = nameChanged or interpDirectionChanged
    latestInterpretationChangeReason := nameChanged ? "Interpretation name changed" : interpDirectionChanged ? "Interpretation direction changed" : ruleStatusChanged ? "Interpretation rule status changed" : confidenceMateriallyChanged ? "Confidence crossed material threshold" : supportMateriallyChanged ? "Major supporting evidence changed" : contradictionAppeared ? "Major contradiction appeared" : breakoutMeaningChanged ? "Breakout lifecycle changed market meaning" : momentumMeaningMateriallyChanged ? "Momentum meaning changed" : "UNRESOLVED"
    if createdNewInterpretation or na(interpretationCreationBarIndex)
        interpretationCreationTime := time
        interpretationCreationBarIndex := bar_index
    interpretationUpdatedTime := time
    interpretationUpdatedBarIndex := bar_index
    currentInterpretation := interpretationCandidateName
    currentInterpretationDirection := interpretationCandidateDirection
    currentInterpretationRuleStatus := interpretationRuleStatus
    currentInterpretationConfidence := interpretationCandidateConfidence
    previousSupportSignature := majorSupportSignature
    previousContradictionSignature := majorContradictionSignature

validationAssessment = not showValidationComparison ? "NOT_ASSESSED" : manualExpectedInterpretation == "" ? "NOT_ASSESSED" : manualExpectedInterpretation == currentInterpretation and (manualExpectedDirection == "" or manualExpectedDirection == currentInterpretationDirection) ? "MATCH" : "MISMATCH"

f_fmt(float value) =>
    na(value) ? "na" : str.tostring(value, "#.####")

// ============================================================================
// 15. VISUAL OUTPUT WITH OBJECT LIMITS
// 圖表輸出與物件數量限制
// ============================================================================

plot(showManualLevels and manualResistance1Enabled ? manualResistance1 : na, "Manual Resistance 1", color=color.new(color.red, 20), linewidth=1, style=plot.style_linebr)
plot(showManualLevels and manualResistance2Enabled ? manualResistance2 : na, "Manual Resistance 2", color=color.new(color.red, 35), linewidth=1, style=plot.style_linebr)
plot(showManualLevels and manualResistance3Enabled ? manualResistance3 : na, "Manual Resistance 3", color=color.new(color.red, 50), linewidth=1, style=plot.style_linebr)
plot(showManualLevels and manualSupport1Enabled ? manualSupport1 : na, "Manual Support 1", color=color.new(color.green, 20), linewidth=1, style=plot.style_linebr)
plot(showManualLevels and manualSupport2Enabled ? manualSupport2 : na, "Manual Support 2", color=color.new(color.green, 35), linewidth=1, style=plot.style_linebr)
plot(showManualLevels and manualSupport3Enabled ? manualSupport3 : na, "Manual Support 3", color=color.new(color.green, 50), linewidth=1, style=plot.style_linebr)
plot(showFib and fibEnabled ? fib382 : na, "Manual Fib 38.2", color=color.new(color.orange, 25), linewidth=1, style=plot.style_linebr)
plot(showFib and fibEnabled ? fib500 : na, "Manual Fib 50.0", color=color.new(color.orange, 10), linewidth=1, style=plot.style_linebr)
plot(showFib and fibEnabled ? fib618 : na, "Manual Fib 61.8", color=color.new(color.orange, 25), linewidth=1, style=plot.style_linebr)
plot(showPreviousLevels ? previousDayHigh : na, "Previous Day High", color=color.new(color.blue, 25), linewidth=1, style=plot.style_linebr)
plot(showPreviousLevels ? previousDayLow : na, "Previous Day Low", color=color.new(color.blue, 25), linewidth=1, style=plot.style_linebr)
plot(showPreviousLevels ? previousSessionHigh : na, "Previous Session High", color=color.new(color.purple, 35), linewidth=1, style=plot.style_linebr)
plot(showPreviousLevels ? previousSessionLow : na, "Previous Session Low", color=color.new(color.purple, 35), linewidth=1, style=plot.style_linebr)
plot(showConsolidation ? frozenConsolidationHigh : na, "Frozen Consolidation High", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_linebr)
plot(showConsolidation ? frozenConsolidationLow : na, "Frozen Consolidation Low", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_linebr)
plot(activeBreakoutLevel, "Active Breakout Level", color=color.new(color.white, 0), linewidth=2, style=plot.style_linebr)
plot(not na(activeBreakoutLevel) ? activeBreakoutLevel + retestTolerance : na, "Retest Zone Upper", color=color.new(color.gray, 60), linewidth=1, style=plot.style_linebr)
plot(not na(activeBreakoutLevel) ? activeBreakoutLevel - retestTolerance : na, "Retest Zone Lower", color=color.new(color.gray, 60), linewidth=1, style=plot.style_linebr)

plotshape(showSwings and not na(confirmedSwingHigh), "Confirmed Swing High", shape.triangledown, location.abovebar, color=color.new(color.red, 0), offset=-swingRight, size=size.tiny)
plotshape(showSwings and not na(confirmedSwingLow), "Confirmed Swing Low", shape.triangleup, location.belowbar, color=color.new(color.green, 0), offset=-swingRight, size=size.tiny)

var array<label> managedLabels = array.new<label>()
f_addLabel(bool enabled, float price, string labelText, color labelColor, styleValue, string tooltipText) =>
    if enabled
        label newLabel = label.new(bar_index, price, labelText, style=styleValue, color=labelColor, textcolor=color.white, size=size.tiny, tooltip=tooltipText)
        array.push(managedLabels, newLabel)
        if array.size(managedLabels) > 120
            label.delete(array.shift(managedLabels))

p1LevelBreak = breakoutState == STATE_BREAK and previousBreakoutState != STATE_BREAK
p1FollowThrough = followThroughEventThisBar and breakoutAttemptId != followThroughAlertedAttemptId
p1FailedBreakout = breakoutState == STATE_FAILED and previousBreakoutState != STATE_FAILED
p1RetestStart = breakoutState == STATE_RETEST and previousBreakoutState != STATE_RETEST
p1RetestHold = breakoutState == STATE_RETEST_HOLD and previousBreakoutState != STATE_RETEST_HOLD
p1RetestFail = breakoutState == STATE_RETEST_FAIL and previousBreakoutState != STATE_RETEST_FAIL
p1Expired = breakoutState == STATE_EXPIRED and previousBreakoutState != STATE_EXPIRED
p1MomentumAcceleration = momentumState == "ACCELERATING" and momentumState[1] != "ACCELERATING"
p1MomentumSlowing = momentumState == "SLOWING" and momentumState[1] != "SLOWING"
p1Exhaustion = momentumState == "EXHAUSTION_CANDIDATE" and momentumState[1] != "EXHAUSTION_CANDIDATE"
p1HealthyContinuation = interpretationChangedThisBar and currentInterpretation == INTERP_HEALTHY
p1MessyContinuation = interpretationChangedThisBar and currentInterpretation == INTERP_MESSY
p1FailedContinuation = interpretationChangedThisBar and currentInterpretation == INTERP_FAILED_CONT
decisionEventText = p1LevelBreak ? "BO " + selectedBreakoutSource : p1FollowThrough ? "FT " + followThroughResult : p1FailedBreakout ? "FB Failed breakout" : p1RetestStart ? "RT Retest start" : p1RetestHold ? "RH Retest hold" : p1RetestFail ? "RF Retest fail" : p1Expired ? "BO Expired" : p1MomentumAcceleration ? "MA Momentum acceleration" : p1MomentumSlowing ? "MS Momentum slowing" : p1Exhaustion ? "ME Exhaustion candidate" : p1HealthyContinuation ? "HC Healthy continuation" : p1MessyContinuation ? "MC Messy continuation" : p1FailedContinuation ? "FC Failed continuation" : interpretationChangedThisBar ? "TC " + currentInterpretation : "NONE"
decisionTooltip = "Priority 1 Decision Event\nEvent: " + decisionEventText + "\nInterpretation: " + currentInterpretation + "\nDirection: " + currentInterpretationDirection + "\nConfidence: " + f_fmt(currentInterpretationConfidence) + "\nSupport: " + support_reason_1 + " | " + support_reason_2 + " | " + support_reason_3 + "\nContradiction: " + contradiction_reason_1 + " | " + contradiction_reason_2 + " | " + contradiction_reason_3 + "\nChange reason: " + latestInterpretationChangeReason
if showBreakoutLabels and decisionEventText != "NONE" and barstate.isconfirmed
    f_addLabel(true, close, decisionEventText, color.new(color.orange, 10), currentInterpretationDirection == DIR_BEAR or breakoutState == STATE_FAILED or breakoutState == STATE_RETEST_FAIL ? label.style_label_down : label.style_label_up, decisionTooltip)

contextFilterAllowsEvidence = not cleanMode and (showAllRawEvidence or fullDebugMode or evidence_at_important_level or evidence_during_breakout_lifecycle or evidence_at_decision_checkpoint or interpretationChangedThisBar or momentumMeaningChanged)
rawTooltipCommon = "\nBody ratio: " + f_fmt(bodyRatio) + "\nRange expansion ratio: " + f_fmt(rangeExpansionRatio) + "\nBody expansion ratio: " + f_fmt(bodyExpansionRatio) + "\nClose location: " + f_fmt(closeLocation) + "\nATR-normalised range: " + f_fmt(f_safeDiv(barRange, atrValue, na)) + "\nNear important level: " + str.tostring(evidence_at_important_level) + "\nBreakout lifecycle active: " + str.tostring(evidence_during_breakout_lifecycle) + "\nInterpretation effect: " + currentInterpretation + "\nNot treated as an automatic reversal or trade signal"
if contextFilterAllowsEvidence and barstate.isconfirmed
    f_addLabel(expansionCandle, high, "E", color.new(color.teal, 25), label.style_label_down, "Expansion Candle" + rawTooltipCommon)
    f_addLabel(bearishEngulfing, high, "BE", color.new(color.maroon, 20), label.style_label_down, "Bearish Engulfing\nCurrent body: " + f_fmt(barBody) + "\nPrevious body: " + f_fmt(barBody[1]) + "\nEngulf ratio: " + f_fmt(f_safeDiv(barBody, barBody[1], na)) + "\nLocation: " + nearestManualSource + "\nMTF alignment: " + (evidence_against_mtf_direction ? "against current candle direction" : evidence_with_mtf_direction ? "with current candle direction" : "unresolved") + rawTooltipCommon)
    f_addLabel(bullishEngulfing, low, "UE", color.new(color.green, 20), label.style_label_up, "Bullish Engulfing\nCurrent body: " + f_fmt(barBody) + "\nPrevious body: " + f_fmt(barBody[1]) + "\nEngulf ratio: " + f_fmt(f_safeDiv(barBody, barBody[1], na)) + "\nLocation: " + nearestManualSource + "\nMTF alignment: " + (evidence_against_mtf_direction ? "against current candle direction" : evidence_with_mtf_direction ? "with current candle direction" : "unresolved") + rawTooltipCommon)
    f_addLabel(bearishRejection, high, "BR", color.new(color.red, 20), label.style_label_down, "Bearish Rejection\nUpper wick ratio: " + f_fmt(upperWickRatio) + "\nWick/body ratio: " + f_fmt(f_safeDiv(upperWick, barBody, na)) + rawTooltipCommon)
    f_addLabel(bullishRejection, low, "UR", color.new(color.lime, 20), label.style_label_up, "Bullish Rejection\nLower wick ratio: " + f_fmt(lowerWickRatio) + "\nWick/body ratio: " + f_fmt(f_safeDiv(lowerWick, barBody, na)) + rawTooltipCommon)
    f_addLabel(weakCloseEvidence, close, "W", color.new(color.gray, 30), label.style_label_left, "Weak Close" + rawTooltipCommon)
    f_addLabel(strongCloseEvidence, close, "S", color.new(color.blue, 25), label.style_label_right, "Strong Close" + rawTooltipCommon)
    f_addLabel(insideBar, low, "I", color.new(color.purple, 35), label.style_label_up, "Inside Bar" + rawTooltipCommon)
    f_addLabel(outsideBar, high, "O", color.new(color.purple, 20), label.style_label_down, "Outside Bar" + rawTooltipCommon)
    f_addLabel(dojiLikeHesitation, close, "D", color.new(color.yellow, 20), label.style_label_left, "Doji / Hesitation" + rawTooltipCommon)
    f_addLabel(smallBodyHesitation, close, "H", color.new(color.yellow, 35), label.style_label_right, "Small-body Hesitation" + rawTooltipCommon)

if fullDebugMode and showCandleLabels and currentCandlePattern != "NONE" and barstate.isconfirmed
    f_addLabel(true, high, currentCandlePattern, color.new(color.teal, 10), label.style_label_down, "Legacy full candle label\nRaw evidence only")
if fullDebugMode and showStateTransitions and stateTransition and barstate.isconfirmed
    f_addLabel(true, close, transitionPreviousState + " -> " + transitionNewState + "\n" + transitionTrigger, color.new(color.gray, 20), label.style_label_left, "Transition record\nPrevious: " + transitionPreviousState + "\nNew: " + transitionNewState + "\nTrigger: " + transitionTrigger)

// ============================================================================
// 15. DEBUG TABLE
// 除錯表格
// ============================================================================

f_jsonFloat(float value) =>
    na(value) ? "null" : str.tostring(value, "#.####")

f_jsonInt(int value) =>
    na(value) ? "null" : str.tostring(value)

var table debugTable = table.new(position.top_right, 2, 46, border_width=1)
f_tableRow(int row, string name, string value) =>
    table.cell(debugTable, 0, row, name, text_color=color.white, bgcolor=color.new(color.black, 15), text_size=size.tiny)
    table.cell(debugTable, 1, row, value, text_color=color.white, bgcolor=color.new(color.black, 35), text_size=size.tiny)

if (cleanMode or validationMode or (fullDebugMode and showDebugTable)) and barstate.islast
    f_tableRow(0, "Current Interpretation", currentInterpretation)
    f_tableRow(1, "Dir / Conf / Rule", currentInterpretationDirection + " / " + f_fmt(currentInterpretationConfidence) + " / " + currentInterpretationRuleStatus)
    f_tableRow(2, "Created / Updated Bar", f_jsonInt(interpretationCreationBarIndex) + " / " + f_jsonInt(interpretationUpdatedBarIndex))
    f_tableRow(3, "Regime / Momentum", currentRegime + " / " + momentumState)
    f_tableRow(4, "Breakout / Session", breakoutState + " / " + currentSession)
    f_tableRow(5, "Nearest Level", nearestManualSource + " " + f_fmt(nearestManualLevel) + " D_ATR:" + f_fmt(f_safeDiv(nearestManualDistance, atrValue, na)))
    f_tableRow(6, "Support", support_reason_1)
    f_tableRow(7, "Contradiction", contradiction_reason_1)
    f_tableRow(8, "Missing", missing_evidence_1)
    f_tableRow(9, "Support 2 / 3", support_reason_2 + " | " + support_reason_3)
    f_tableRow(10, "Contradict / Missing 2", contradiction_reason_2 + " | " + missing_evidence_2)
    f_tableRow(11, "Raw / Context", (rawCandleEvidenceSummary == "" ? "NONE" : rawCandleEvidenceSummary) + " / " + (contextualEvidenceSummary == "" ? "NONE" : contextualEvidenceSummary))
    f_tableRow(12, "Latest Change", latestInterpretationChangeReason)
    f_tableRow(13, "Validation", validationCaseId + " " + validationAssessment + " M:" + manualExpectedInterpretation + "/" + manualExpectedDirection)
    if fullDebugMode
        f_tableRow(14, "Created / Updated Time", f_jsonInt(interpretationCreationTime) + " / " + f_jsonInt(interpretationUpdatedTime))
        f_tableRow(15, "Pine Interpretation", currentInterpretation + " / " + currentInterpretationDirection)
        f_tableRow(16, "Latest Transition", transitionPreviousState + " -> " + transitionNewState + " / " + transitionTrigger)
        f_tableRow(17, "Trend Score / 趨勢分", f_fmt(trendScore) + " S:" + f_fmt(structureScore) + " E:" + f_fmt(efficiencyScore) + " A:" + f_fmt(alignmentScoreAbs) + " D:" + f_fmt(directionalCloseScore))
        f_tableRow(18, "Consolidation Score / 整固分", f_fmt(consolidationScore) + " LE:" + f_fmt(lowEfficiencyScore) + " O:" + f_fmt(highOverlapScore) + " R:" + f_fmt(containedRangeScore) + " C:" + f_fmt(directionChangeScore))
        f_tableRow(19, "Messy Score / 混亂分", f_fmt(messyScore) + " DC:" + f_fmt(directionChangeScore) + " FB:" + f_fmt(failedBreakScore) + " TF:" + f_fmt(timeframeConflictScore) + " AE:" + f_fmt(alternatingExpansionScore))
        f_tableRow(20, "M5/M15/M30/H1", f_dirText(m5Direction) + " / " + f_dirText(m15Direction) + " / " + f_dirText(m30Direction) + " / " + f_dirText(h1Direction))
        f_tableRow(21, "Alignment Score / 一致分", f_fmt(alignmentScoreSigned))
        f_tableRow(22, "Candle Pattern / 蠟燭形態", currentCandlePattern + " BR:" + f_fmt(bodyRatio) + " CL:" + f_fmt(closeLocation) + " RER:" + f_fmt(rangeExpansionRatio))
        f_tableRow(23, "Breakout Bar / 突破K線", "Level:" + f_fmt(activeBreakoutLevel) + " Src:" + activeBreakoutSource + " Idx:" + str.tostring(breakoutBarIndex) + " Time:" + str.tostring(breakoutBarTime) + " Offset:" + str.tostring(barOffsetFromBreakout) + " ResetPending:" + str.tostring(lifecycleResetPending))
        f_tableRow(24, "Breakout Quality / 突破質素", "Candidate:" + str.tostring(activeBreakoutCandidateQualified) + " Q:" + f_fmt(activeBreakoutQualityScore) + " Live:" + f_fmt(breakoutQualityScore) + " B:" + f_fmt(bodyQuality) + " C:" + f_fmt(closeQuality) + " D:" + f_fmt(breakDistanceQuality) + " X:" + f_fmt(expansionQuality) + " W:" + f_fmt(oppositeWickPenalty))
        f_tableRow(25, "Follow-Through / 跟進", "Eval:" + str.tostring(followThroughEvaluatedThisBar) + " Result:" + followThroughResult + " Outside:" + str.tostring(consecutiveOutsideCloses))
        f_tableRow(26, "Previous Day H/L / 前日高低", f_fmt(previousDayHigh) + " / " + f_fmt(previousDayLow))
        f_tableRow(27, "Previous Session H/L / 前時段高低", f_fmt(previousSessionHigh) + " / " + f_fmt(previousSessionLow))
        f_tableRow(28, "Consolidation H/L / 整固高低", f_fmt(frozenConsolidationHigh) + " / " + f_fmt(frozenConsolidationLow) + " Frozen:" + str.tostring(consolidationFrozen))
        f_tableRow(29, "VAH/VAL/POC / 價值區", f_fmt(vah) + " / " + f_fmt(val) + " / " + f_fmt(poc) + " " + profileStatus)
        f_tableRow(30, "Session Detail / 時段", "Open:" + f_fmt(sessionOpen) + " High:" + f_fmt(sessionHigh) + " Low:" + f_fmt(sessionLow) + " Dir:" + sessionDirection + " Min:" + f_jsonInt(minutesFromSessionStart))
        f_tableRow(31, "Session Sweeps / 時段掃位", "High:" + str.tostring(sessionHighSwept) + " Low:" + str.tostring(sessionLowSwept) + " AsianH:" + str.tostring(londonBreaksAsianHigh) + " AsianL:" + str.tostring(londonBreaksAsianLow))
        f_tableRow(32, "News State / 新聞狀態", newsState + " " + newsCurrency + " " + newsImpact)
        f_tableRow(33, "Candle Equations / 蠟燭公式", "Range:" + f_fmt(barRange) + " Body:" + f_fmt(barBody) + " UW:" + f_fmt(upperWickRatio) + " LW:" + f_fmt(lowerWickRatio))
        f_tableRow(34, "Break Counts / 突破次數", "Attempts:" + str.tostring(breakoutAttemptCount) + " Failed:" + str.tostring(failedBreakCount) + " Ratio:" + f_fmt(failedBreakRatio))

// ============================================================================
// 16. CHECKPOINT ALERTS AND JSON OUTPUT
// 檢查點警報與 JSON 輸出
// ============================================================================

checkpointSessionChange = sessionChanged
checkpointApproach = breakoutState == STATE_APPROACH and previousBreakoutState != STATE_APPROACH
checkpointLevelBreak = breakoutState == STATE_BREAK and previousBreakoutState != STATE_BREAK
checkpointFollowThrough = followThroughEventThisBar and breakoutAttemptId != followThroughAlertedAttemptId
checkpointFailedBreakout = breakoutState == STATE_FAILED and previousBreakoutState != STATE_FAILED
checkpointRetestStart = breakoutState == STATE_RETEST and previousBreakoutState != STATE_RETEST
checkpointRetestHold = breakoutState == STATE_RETEST_HOLD and previousBreakoutState != STATE_RETEST_HOLD
checkpointRetestFail = breakoutState == STATE_RETEST_FAIL and previousBreakoutState != STATE_RETEST_FAIL
checkpointExpired = breakoutState == STATE_EXPIRED and previousBreakoutState != STATE_EXPIRED
checkpointLifecycleReset = transitionOccurredThisBar and transitionTrigger == "LIFECYCLE_RESET"
checkpointMaterialInterpretationChange = interpretationChangedThisBar
checkpointBullishEngulfing = alertContextualCandleEvidence and contextFilterAllowsEvidence and bullishEngulfing
checkpointBearishEngulfing = alertContextualCandleEvidence and contextFilterAllowsEvidence and bearishEngulfing
checkpointStrongRejection = alertContextualCandleEvidence and contextFilterAllowsEvidence and strongRejection
checkpointMomentumAcceleration = momentumState == "ACCELERATING" and momentumState[1] != "ACCELERATING"
checkpointMomentumSlowing = momentumState == "SLOWING" and momentumState[1] != "SLOWING"
checkpointExhaustion = momentumState == "EXHAUSTION_CANDIDATE" and momentumState[1] != "EXHAUSTION_CANDIDATE"
checkpointRegimeChange = currentRegime != currentRegime[1]
checkpointNewsWindowStart = newsState == "PRE_NEWS_WINDOW" and newsState[1] != "PRE_NEWS_WINDOW"
checkpointNewsFollowThrough = newsFollowThrough and not newsFollowThrough[1]
checkpointNewsFade = newsFade and not newsFade[1]

primaryEvent = checkpointLevelBreak ? "LEVEL_BREAK" : checkpointFollowThrough ? "SECOND_BAR_FOLLOW_THROUGH_RESULT" : checkpointFailedBreakout ? "FAILED_BREAKOUT" : checkpointRetestStart ? "RETEST_START" : checkpointRetestHold ? "RETEST_HOLD" : checkpointRetestFail ? "RETEST_FAIL" : checkpointExpired ? "BREAKOUT_EXPIRED" : checkpointLifecycleReset ? "BREAKOUT_LIFECYCLE_RESET" : checkpointMaterialInterpretationChange ? "MATERIAL_INTERPRETATION_CHANGE" : checkpointMomentumAcceleration ? "MOMENTUM_ACCELERATION" : checkpointMomentumSlowing ? "MOMENTUM_SLOWING" : checkpointExhaustion ? "EXHAUSTION_CANDIDATE" : checkpointRegimeChange ? "REGIME_CHANGE" : checkpointNewsWindowStart ? "NEWS_WINDOW_START" : checkpointNewsFollowThrough ? "NEWS_FOLLOW_THROUGH" : checkpointNewsFade ? "NEWS_FADE" : checkpointSessionChange ? "SESSION_CHANGE" : checkpointApproach ? "APPROACH_TO_IMPORTANT_LEVEL" : checkpointBullishEngulfing ? "BULLISH_ENGULFING_CONTEXTUAL_EVIDENCE" : checkpointBearishEngulfing ? "BEARISH_ENGULFING_CONTEXTUAL_EVIDENCE" : checkpointStrongRejection ? "STRONG_REJECTION_CONTEXTUAL_EVIDENCE" : "NONE"
secondaryEvents = ""
secondaryEvents := checkpointMaterialInterpretationChange and primaryEvent != "MATERIAL_INTERPRETATION_CHANGE" ? secondaryEvents + (secondaryEvents != "" ? "|" : "") + "MATERIAL_INTERPRETATION_CHANGE" : secondaryEvents
secondaryEvents := checkpointMomentumAcceleration and primaryEvent != "MOMENTUM_ACCELERATION" ? secondaryEvents + (secondaryEvents != "" ? "|" : "") + "MOMENTUM_ACCELERATION" : secondaryEvents
secondaryEvents := checkpointMomentumSlowing and primaryEvent != "MOMENTUM_SLOWING" ? secondaryEvents + (secondaryEvents != "" ? "|" : "") + "MOMENTUM_SLOWING" : secondaryEvents
secondaryEvents := checkpointExhaustion and primaryEvent != "EXHAUSTION_CANDIDATE" ? secondaryEvents + (secondaryEvents != "" ? "|" : "") + "EXHAUSTION_CANDIDATE" : secondaryEvents
secondaryEvents := checkpointBullishEngulfing and primaryEvent != "BULLISH_ENGULFING_CONTEXTUAL_EVIDENCE" ? secondaryEvents + (secondaryEvents != "" ? "|" : "") + "BULLISH_ENGULFING_CONTEXTUAL_EVIDENCE" : secondaryEvents
secondaryEvents := checkpointBearishEngulfing and primaryEvent != "BEARISH_ENGULFING_CONTEXTUAL_EVIDENCE" ? secondaryEvents + (secondaryEvents != "" ? "|" : "") + "BEARISH_ENGULFING_CONTEXTUAL_EVIDENCE" : secondaryEvents
secondaryEvents := checkpointStrongRejection and primaryEvent != "STRONG_REJECTION_CONTEXTUAL_EVIDENCE" ? secondaryEvents + (secondaryEvents != "" ? "|" : "") + "STRONG_REJECTION_CONTEXTUAL_EVIDENCE" : secondaryEvents
checkpointEvent = primaryEvent

checkpointTriggered = checkpointEvent != "NONE"
var int lastAlertBar = na
var string lastAlertEvent = "NONE"
var int lastAlertAttemptId = na
alertAlreadySent = lastAlertBar == bar_index and lastAlertEvent == checkpointEvent and lastAlertAttemptId == breakoutAttemptId
alertAllowed = barstate.isrealtime and barstate.isconfirmed

exportBreakoutStateCode = f_breakoutStateCode(breakoutState)
exportInterpretationCode = f_interpretationCode(currentInterpretation)
exportInterpretationDirectionCode = f_directionCode(currentInterpretationDirection)
exportRegimeCode = f_regimeCode(currentRegime)
exportMomentumCode = f_momentumCode(momentumState)
exportSessionCode = f_sessionCode(currentSession)
exportSessionDirectionCode = f_directionCode(sessionDirection)
exportProfileStatusCode = f_profileStatusCode(profileStatus)
exportNearestManualDistanceAtr = f_safeDiv(nearestManualDistance, atrValue, na)
exportAtrNormalisedRange = f_safeDiv(barRange, atrValue, na)

jsonOutput = "{" +
     "\"schema_version\":" + f_jsonString(EXPORT_SCHEMA_VERSION) + "," +
     "\"indicator_version\":" + f_jsonString(INDICATOR_VERSION) + "," +
     "\"event\":" + f_jsonString(checkpointEvent) + "," +
     "\"primary_event\":" + f_jsonString(primaryEvent) + "," +
     "\"secondary_events\":" + f_jsonString(secondaryEvents) + "," +
     "\"checkpoint_event\":" + f_jsonString(checkpointEvent) + "," +
     "\"symbol\":" + f_jsonString(syminfo.ticker) + "," +
     "\"exchange\":" + f_jsonString(syminfo.prefix) + "," +
     "\"timeframe\":" + f_jsonString(timeframe.period) + "," +
     "\"chart_timeframe\":" + f_jsonString(timeframe.period) + "," +
     "\"bar_index\":" + str.tostring(bar_index) + "," +
     "\"bar_time\":" + str.tostring(time) + "," +
     "\"confirmed\":" + str.tostring(barstate.isconfirmed) + "," +
     "\"timestamp\":" + str.tostring(time) + "," +
     "\"ohlcv\":{\"open\":" + f_jsonFloat(open) + ",\"high\":" + f_jsonFloat(high) + ",\"low\":" + f_jsonFloat(low) + ",\"close\":" + f_jsonFloat(close) + ",\"volume\":" + f_jsonFloat(volume) + "}," +
     "\"interpretation\":{\"name\":" + f_jsonString(currentInterpretation) + ",\"direction\":" + f_jsonString(currentInterpretationDirection) + ",\"rule_status\":" + f_jsonString(currentInterpretationRuleStatus) + ",\"confidence\":" + f_jsonFloat(currentInterpretationConfidence) + ",\"created_time\":" + f_jsonInt(interpretationCreationTime) + ",\"created_bar_index\":" + f_jsonInt(interpretationCreationBarIndex) + ",\"updated_time\":" + f_jsonInt(interpretationUpdatedTime) + ",\"updated_bar_index\":" + f_jsonInt(interpretationUpdatedBarIndex) + ",\"changed_this_bar\":" + str.tostring(interpretationChangedThisBar) + "}," +
     "\"evidence\":{\"supporting\":[" + f_jsonString(support_reason_1) + "," + f_jsonString(support_reason_2) + "," + f_jsonString(support_reason_3) + "],\"contradicting\":[" + f_jsonString(contradiction_reason_1) + "," + f_jsonString(contradiction_reason_2) + "," + f_jsonString(contradiction_reason_3) + "],\"missing\":[" + f_jsonString(missing_evidence_1) + "," + f_jsonString(missing_evidence_2) + "]}," +
     "\"raw_candle_evidence\":{\"expansion\":" + str.tostring(expansionCandle) + ",\"bullish_engulfing\":" + str.tostring(bullishEngulfing) + ",\"bearish_engulfing\":" + str.tostring(bearishEngulfing) + ",\"bullish_rejection\":" + str.tostring(bullishRejection) + ",\"bearish_rejection\":" + str.tostring(bearishRejection) + ",\"inside_bar\":" + str.tostring(insideBar) + ",\"outside_bar\":" + str.tostring(outsideBar) + ",\"doji\":" + str.tostring(dojiLikeHesitation) + ",\"small_body\":" + str.tostring(smallBodyHesitation) + ",\"weak_close\":" + str.tostring(weakCloseEvidence) + ",\"strong_close\":" + str.tostring(strongCloseEvidence) + "}," +
     "\"context_flags\":{\"near_manual_level\":" + str.tostring(evidence_near_manual_level) + ",\"near_previous_day\":" + str.tostring(evidence_near_previous_day_level) + ",\"near_previous_session\":" + str.tostring(evidence_near_previous_session_level) + ",\"near_consolidation_boundary\":" + str.tostring(evidence_near_consolidation_boundary) + ",\"near_value_area\":" + str.tostring(evidence_near_value_area_level) + ",\"during_breakout\":" + str.tostring(evidence_during_breakout_lifecycle) + ",\"after_expansion\":" + str.tostring(evidence_after_expansion) + ",\"after_failed_push\":" + str.tostring(evidence_after_failed_push) + ",\"with_mtf_direction\":" + str.tostring(evidence_with_mtf_direction) + ",\"against_mtf_direction\":" + str.tostring(evidence_against_mtf_direction) + ",\"progress_accelerating\":" + str.tostring(evidence_progress_accelerating) + ",\"progress_declining\":" + str.tostring(evidence_progress_declining) + ",\"range_expanding\":" + str.tostring(evidence_range_expanding) + ",\"range_contracting\":" + str.tostring(evidence_range_contracting) + ",\"close_quality_improving\":" + str.tostring(evidence_close_quality_improving) + ",\"close_quality_weakening\":" + str.tostring(evidence_close_quality_weakening) + ",\"session_open_phase\":" + str.tostring(evidence_session_open_phase) + ",\"session_late_phase\":" + str.tostring(evidence_session_late_phase) + ",\"at_important_level\":" + str.tostring(evidence_at_important_level) + ",\"at_decision_checkpoint\":" + str.tostring(evidence_at_decision_checkpoint) + ",\"session_phase\":" + f_jsonString(currentSession) + "}," +
     "\"session_context\":{\"phase\":" + f_jsonString(currentSession) + ",\"minutes_from_start\":" + f_jsonInt(minutesFromSessionStart) + ",\"session_open\":" + f_jsonFloat(sessionOpen) + ",\"session_high\":" + f_jsonFloat(sessionHigh) + ",\"session_low\":" + f_jsonFloat(sessionLow) + ",\"range_atr\":" + f_jsonFloat(sessionRangeAtr) + ",\"net_progress_atr\":" + f_jsonFloat(sessionNetProgressAtr) + ",\"efficiency\":" + f_jsonFloat(sessionEfficiency) + ",\"direction\":" + f_jsonString(sessionDirection) + ",\"high_swept\":" + str.tostring(sessionHighSwept) + ",\"low_swept\":" + str.tostring(sessionLowSwept) + ",\"overnight_consolidation\":" + str.tostring(overnightConsolidation) + ",\"london_breaks_asian_high\":" + str.tostring(londonBreaksAsianHigh) + ",\"london_breaks_asian_low\":" + str.tostring(londonBreaksAsianLow) + ",\"post_london_momentum_decline\":" + str.tostring(postLondonMomentumDecline) + "}," +
     "\"breakout_attempt_id\":" + str.tostring(breakoutAttemptId) + "," +
     "\"breakout_bar_index\":" + f_jsonInt(breakoutBarIndex) + "," +
     "\"breakout_bar_time\":" + f_jsonInt(breakoutBarTime) + "," +
     "\"bar_offset_from_breakout\":" + f_jsonInt(barOffsetFromBreakout) + "," +
     "\"transition_occurred_this_bar\":" + str.tostring(transitionOccurredThisBar) + "," +
     "\"follow_through_evaluated_this_bar\":" + str.tostring(followThroughEvaluatedThisBar) + "," +
     "\"lifecycle_reset_pending\":" + str.tostring(lifecycleResetPending) + "," +
     "\"session\":" + f_jsonString(currentSession) + "," +
     "\"regime\":" + f_jsonString(currentRegime) + "," +
     "\"structure\":{\"m5\":{\"direction\":" + f_jsonString(f_dirText(m5Direction)) + ",\"trend\":" + str.tostring(m5Direction) + ",\"open\":" + f_jsonFloat(m5ConfirmedOpen) + ",\"high\":" + f_jsonFloat(m5ConfirmedHigh) + ",\"low\":" + f_jsonFloat(m5ConfirmedLow) + ",\"close\":" + f_jsonFloat(m5ConfirmedClose) + ",\"volume\":" + f_jsonFloat(m5ConfirmedVolume) + ",\"time\":" + f_jsonInt(m5ConfirmedTime) + ",\"range\":" + f_jsonFloat(m5Range) + ",\"atr\":" + f_jsonFloat(m5Atr) + ",\"swing_high\":" + f_jsonFloat(m5SwingHigh) + ",\"swing_low\":" + f_jsonFloat(m5SwingLow) + ",\"efficiency\":" + f_jsonFloat(m5Efficiency) + ",\"bullish_close_ratio\":" + f_jsonFloat(m5BullCloseRatio) + ",\"bearish_close_ratio\":" + f_jsonFloat(m5BearCloseRatio) + "}," +
     "\"m15\":{\"direction\":" + f_jsonString(f_dirText(m15Direction)) + ",\"trend\":" + str.tostring(m15Direction) + ",\"open\":" + f_jsonFloat(m15ConfirmedOpen) + ",\"high\":" + f_jsonFloat(m15ConfirmedHigh) + ",\"low\":" + f_jsonFloat(m15ConfirmedLow) + ",\"close\":" + f_jsonFloat(m15ConfirmedClose) + ",\"volume\":" + f_jsonFloat(m15ConfirmedVolume) + ",\"time\":" + f_jsonInt(m15ConfirmedTime) + ",\"range\":" + f_jsonFloat(m15Range) + ",\"atr\":" + f_jsonFloat(m15Atr) + ",\"swing_high\":" + f_jsonFloat(m15SwingHigh) + ",\"swing_low\":" + f_jsonFloat(m15SwingLow) + ",\"efficiency\":" + f_jsonFloat(m15Efficiency) + ",\"bullish_close_ratio\":" + f_jsonFloat(m15BullCloseRatio) + ",\"bearish_close_ratio\":" + f_jsonFloat(m15BearCloseRatio) + "}," +
     "\"m30\":{\"direction\":" + f_jsonString(f_dirText(m30Direction)) + ",\"trend\":" + str.tostring(m30Direction) + ",\"open\":" + f_jsonFloat(m30ConfirmedOpen) + ",\"high\":" + f_jsonFloat(m30ConfirmedHigh) + ",\"low\":" + f_jsonFloat(m30ConfirmedLow) + ",\"close\":" + f_jsonFloat(m30ConfirmedClose) + ",\"volume\":" + f_jsonFloat(m30ConfirmedVolume) + ",\"time\":" + f_jsonInt(m30ConfirmedTime) + ",\"range\":" + f_jsonFloat(m30Range) + ",\"atr\":" + f_jsonFloat(m30Atr) + ",\"swing_high\":" + f_jsonFloat(m30SwingHigh) + ",\"swing_low\":" + f_jsonFloat(m30SwingLow) + ",\"efficiency\":" + f_jsonFloat(m30Efficiency) + ",\"bullish_close_ratio\":" + f_jsonFloat(m30BullCloseRatio) + ",\"bearish_close_ratio\":" + f_jsonFloat(m30BearCloseRatio) + "}," +
     "\"h1\":{\"direction\":" + f_jsonString(f_dirText(h1Direction)) + ",\"trend\":" + str.tostring(h1Direction) + ",\"open\":" + f_jsonFloat(h1ConfirmedOpen) + ",\"high\":" + f_jsonFloat(h1ConfirmedHigh) + ",\"low\":" + f_jsonFloat(h1ConfirmedLow) + ",\"close\":" + f_jsonFloat(h1ConfirmedClose) + ",\"volume\":" + f_jsonFloat(h1ConfirmedVolume) + ",\"time\":" + f_jsonInt(h1ConfirmedTime) + ",\"range\":" + f_jsonFloat(h1Range) + ",\"atr\":" + f_jsonFloat(h1Atr) + ",\"swing_high\":" + f_jsonFloat(h1SwingHigh) + ",\"swing_low\":" + f_jsonFloat(h1SwingLow) + ",\"efficiency\":" + f_jsonFloat(h1Efficiency) + ",\"bullish_close_ratio\":" + f_jsonFloat(h1BullCloseRatio) + ",\"bearish_close_ratio\":" + f_jsonFloat(h1BearCloseRatio) + "}}," +
     "\"momentum\":" + f_jsonString(momentumState) + "," +
     "\"enum_codes\":{\"breakout_state\":" + str.tostring(exportBreakoutStateCode) + ",\"interpretation\":" + str.tostring(exportInterpretationCode) + ",\"interpretation_direction\":" + str.tostring(exportInterpretationDirectionCode) + ",\"market_regime\":" + str.tostring(exportRegimeCode) + ",\"momentum_state\":" + str.tostring(exportMomentumCode) + ",\"session_phase\":" + str.tostring(exportSessionCode) + ",\"session_direction\":" + str.tostring(exportSessionDirectionCode) + ",\"profile_status\":" + str.tostring(exportProfileStatusCode) + "}," +
     "\"breakout\":{\"level\":" + f_jsonFloat(activeBreakoutLevel) + ",\"level_type\":" + f_jsonString(activeBreakoutSource) + ",\"direction\":" + str.tostring(activeBreakoutDirection) + ",\"state\":" + f_jsonString(breakoutState) + ",\"attempt_id\":" + str.tostring(breakoutAttemptId) + ",\"breakout_high\":" + f_jsonFloat(activeBreakoutDirection > 0 ? activeBreakoutLevel : activeConsolidationHigh) + ",\"breakout_low\":" + f_jsonFloat(activeBreakoutDirection < 0 ? activeBreakoutLevel : activeConsolidationLow) + ",\"candidate\":" + str.tostring(breakoutCandidate) + ",\"active_candidate\":" + str.tostring(activeBreakoutCandidateQualified) + ",\"follow_through\":" + f_jsonString(followThroughResult) + ",\"failed_breakout\":" + str.tostring(breakoutState == STATE_FAILED or breakoutState == STATE_RETEST_FAIL) + ",\"expired\":" + str.tostring(breakoutState == STATE_EXPIRED) + ",\"creation_time\":" + f_jsonInt(activeBreakoutCreationTime) + ",\"age_bars\":" + str.tostring(breakoutAge) + ",\"consecutive_outside_closes\":" + str.tostring(consecutiveOutsideCloses) + ",\"quality_score\":" + f_jsonFloat(activeBreakoutQualityScore) + ",\"live_quality_score\":" + f_jsonFloat(breakoutQualityScore) + "}," +
     "\"candle\":{\"body_size\":" + f_jsonFloat(barBody) + ",\"body_ratio\":" + f_jsonFloat(bodyRatio) + ",\"body_expansion_ratio\":" + f_jsonFloat(bodyExpansionRatio) + ",\"range\":" + f_jsonFloat(barRange) + ",\"range_expansion_ratio\":" + f_jsonFloat(rangeExpansionRatio) + ",\"upper_wick\":" + f_jsonFloat(upperWick) + ",\"lower_wick\":" + f_jsonFloat(lowerWick) + ",\"upper_wick_ratio\":" + f_jsonFloat(upperWickRatio) + ",\"lower_wick_ratio\":" + f_jsonFloat(lowerWickRatio) + ",\"close_location\":" + f_jsonFloat(closeLocation) + ",\"atr\":" + f_jsonFloat(atrValue) + ",\"atr_normalised_range\":" + f_jsonFloat(exportAtrNormalisedRange) + "}," +
     "\"scores\":{\"trend\":" + f_jsonFloat(trendScore) + ",\"structure\":" + f_jsonFloat(structureScore) + ",\"efficiency\":" + f_jsonFloat(efficiencyScore) + ",\"alignment_abs\":" + f_jsonFloat(alignmentScoreAbs) + ",\"alignment\":" + f_jsonFloat(alignmentScoreSigned) + ",\"timeframe_conflict\":" + f_jsonFloat(timeframeConflictScore) + ",\"directional_close\":" + f_jsonFloat(directionalCloseScore) + ",\"consolidation\":" + f_jsonFloat(consolidationScore) + ",\"low_efficiency\":" + f_jsonFloat(lowEfficiencyScore) + ",\"high_overlap\":" + f_jsonFloat(highOverlapScore) + ",\"contained_range\":" + f_jsonFloat(containedRangeScore) + ",\"direction_change\":" + f_jsonFloat(directionChangeScore) + ",\"messy\":" + f_jsonFloat(messyScore) + ",\"alternating_expansion\":" + f_jsonFloat(alternatingExpansionScore) + ",\"failed_break\":" + f_jsonFloat(failedBreakScore) + ",\"breakout_quality_raw\":" + f_jsonFloat(breakoutQualityRaw) + ",\"breakout_quality\":" + f_jsonFloat(breakoutQualityScore) + ",\"active_breakout_quality\":" + f_jsonFloat(activeBreakoutQualityScore) + ",\"body_quality\":" + f_jsonFloat(bodyQuality) + ",\"close_quality\":" + f_jsonFloat(closeQuality) + ",\"break_distance_quality\":" + f_jsonFloat(breakDistanceQuality) + ",\"expansion_quality\":" + f_jsonFloat(expansionQuality) + ",\"opposite_wick_penalty\":" + f_jsonFloat(oppositeWickPenalty) + ",\"support_evidence_count\":" + f_jsonFloat(supportEvidenceCount) + ",\"contradiction_evidence_count\":" + f_jsonFloat(contradictionEvidenceCount) + ",\"important_level_context\":" + f_jsonFloat(importantLevelContextScore) + ",\"candidate_confidence_raw\":" + f_jsonFloat(candidateConfidenceRaw) + ",\"interpretation_candidate_confidence\":" + f_jsonFloat(interpretationCandidateConfidence) + ",\"confidence\":" + f_jsonFloat(currentInterpretationConfidence) + "}," +
     "\"levels\":{\"manual\":{\"resistance_1\":" + f_jsonFloat(manualResistance1Enabled ? manualResistance1 : na) + ",\"resistance_2\":" + f_jsonFloat(manualResistance2Enabled ? manualResistance2 : na) + ",\"resistance_3\":" + f_jsonFloat(manualResistance3Enabled ? manualResistance3 : na) + ",\"support_1\":" + f_jsonFloat(manualSupport1Enabled ? manualSupport1 : na) + ",\"support_2\":" + f_jsonFloat(manualSupport2Enabled ? manualSupport2 : na) + ",\"support_3\":" + f_jsonFloat(manualSupport3Enabled ? manualSupport3 : na) + ",\"fib_382\":" + f_jsonFloat(fibEnabled ? fib382 : na) + ",\"fib_500\":" + f_jsonFloat(fibEnabled ? fib500 : na) + ",\"fib_618\":" + f_jsonFloat(fibEnabled ? fib618 : na) + "},\"nearest_manual\":{\"source\":" + f_jsonString(nearestManualSource) + ",\"level\":" + f_jsonFloat(nearestManualLevel) + ",\"distance\":" + f_jsonFloat(nearestManualDistance) + ",\"distance_atr\":" + f_jsonFloat(exportNearestManualDistanceAtr) + "},\"nearest_level\":{\"source\":" + f_jsonString(selectedBreakoutSource) + ",\"level\":" + f_jsonFloat(selectedBreakoutLevel) + ",\"distance\":" + f_jsonFloat(selectedDistance) + ",\"distance_atr\":" + f_jsonFloat(f_safeDiv(selectedDistance, atrValue, na)) + "},\"previous_day\":{\"high\":" + f_jsonFloat(previousDayHigh) + ",\"low\":" + f_jsonFloat(previousDayLow) + "},\"previous_session\":{\"high\":" + f_jsonFloat(previousSessionHigh) + ",\"low\":" + f_jsonFloat(previousSessionLow) + "},\"consolidation\":{\"high\":" + f_jsonFloat(frozenConsolidationHigh) + ",\"low\":" + f_jsonFloat(frozenConsolidationLow) + ",\"active_high\":" + f_jsonFloat(activeConsolidationHigh) + ",\"active_low\":" + f_jsonFloat(activeConsolidationLow) + "},\"value_area\":{\"vah\":" + f_jsonFloat(vah) + ",\"val\":" + f_jsonFloat(val) + ",\"poc\":" + f_jsonFloat(poc) + ",\"status\":" + f_jsonString(profileStatus) + "}}," +
     "\"transition\":{\"previous_state\":" + f_jsonString(transitionPreviousState) + ",\"new_state\":" + f_jsonString(transitionNewState) + ",\"time\":" + f_jsonInt(transitionTime) + ",\"price\":" + f_jsonFloat(transitionPrice) + ",\"trigger\":" + f_jsonString(transitionTrigger) + ",\"relevant_level\":" + f_jsonFloat(transitionRelevantLevel) + ",\"timeframe\":" + f_jsonString(transitionTimeframe) + "}," +
     "\"news\":{\"state\":" + f_jsonString(newsState) + ",\"currency\":" + f_jsonString(newsCurrency) + ",\"impact\":" + f_jsonString(newsImpact) + ",\"expected_direction\":" + f_jsonString(newsExpectedDirection) + ",\"observed_direction\":" + str.tostring(observedReactionDirection) + ",\"normalised_reaction\":" + f_jsonFloat(normalisedReaction) + ",\"fade_ratio\":" + f_jsonFloat(fadeRatio) + ",\"divergence\":" + str.tostring(newsDivergence) + "}" +
     "}"

if alertAllowed and (na(lastAlertBar) or lastAlertBar != bar_index)
    alert(jsonOutput, alert.freq_once_per_bar_close)
    lastAlertBar := bar_index
    lastAlertEvent := checkpointEvent
    lastAlertAttemptId := breakoutAttemptId
    if checkpointFollowThrough
        followThroughAlertedAttemptId := breakoutAttemptId
        followThroughAlertedEvent := checkpointEvent
        followThroughAlertedBar := bar_index

