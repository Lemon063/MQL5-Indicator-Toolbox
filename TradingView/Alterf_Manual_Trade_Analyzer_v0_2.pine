displayMode = input.string(DISPLAY_VALIDATION, "Display Mode / 顯示模式", options=[DISPLAY_CLEAN, DISPLAY_VALIDATION, DISPLAY_FULL_DEBUG], group="01 Display / 顯示")
showAllRawEvidence = input.bool(false, "Show All Raw Evidence / 顯示所有原始證據", group="01 Display / 顯示")
showDebugTable = input.bool(true, "Show Debug Table / 顯示除錯表格", group="01 Display / 顯示")
showCandleLabels = input.bool(false, "Legacy Full Candle Labels / 舊式完整蠟燭標籤", group="01 Display / 顯示")
showBreakoutLabels = input.bool(true, "Show Breakout State Labels / 顯示突破狀態標籤", group="01 Display / 顯示")
showManualLevels = input.bool(true, "Show Manual Levels / 顯示人手水平", group="01 Display / 顯示")
showPreviousLevels = input.bool(true, "Show Previous High/Low / 顯示前高前低", group="01 Display / 顯示")
showSwings = input.bool(true, "Show Confirmed Swings / 顯示已確認擺動", group="01 Display / 顯示")
